<!-- Shared JavaScripts (Theme toggling, Lucide icons, smooth scroll anchors) -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Theme Mode Synchronization Script
    const themeBtn = document.getElementById('themeToggleBtn');
    const legacyBtn = document.getElementById('themeToggle') || document.getElementById('themeToggleBtnMobile');

    function updateIcons(isDark) {
        const icons = document.querySelectorAll('#themeToggleBtn i, #themeToggle i, #themeToggleBtnMobile i');
        icons.forEach(icon => {
            if (isDark) {
                icon.className = 'fas fa-sun text-amber-400';
            } else {
                icon.className = 'fas fa-moon text-indigo-500';
            }
        });
    }

    function toggleTheme() {
        const html = document.documentElement;
        const body = document.body;
        const currentTheme = html.getAttribute('data-theme') || 'light';
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

        html.setAttribute('data-theme', newTheme);
        if (newTheme === 'dark') {
            html.classList.add('dark');
            body.classList.add('dark');
        } else {
            html.classList.remove('dark');
            body.classList.remove('dark');
        }

        localStorage.setItem('theme', newTheme);
        updateIcons(newTheme === 'dark');

        // Dispatch theme-changed event for charts/scripts
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: newTheme } }));
    }

    // Attach listeners
    if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
    if (legacyBtn) legacyBtn.addEventListener('click', toggleTheme);

    // Initial icon state
    const initDark = document.documentElement.classList.contains('dark');
    updateIcons(initDark);

    // Initialize Lucide Icons if available
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
});
</script>

