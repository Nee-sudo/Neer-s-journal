<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<%- include('partials/head', { title: "Neer's Diary - Daily Thoughts" }) %>
<body class="bg-journalBg text-journalText font-body antialiased selection:bg-indigo-500/30 selection:text-journalText page-fade-in min-h-screen flex flex-col justify-between">

    <%- include('partials/nav') %>

    <main class="max-w-4xl mx-auto px-6 py-12 space-y-12 flex-1 w-full">

        <!-- Page Header -->
        <div class="border-b border-journalBorder pb-6 space-y-2 text-center md:text-left">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 text-xs font-mono">
                <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                DAILY DIARY & THOUGHT LOGS
            </div>
            <h1 class="font-display text-3xl md:text-4xl font-extrabold text-journalText flex items-center justify-center md:justify-start gap-3">
                <i class="fas fa-feather-alt text-indigo-500"></i> Welcome to My Diary
            </h1>
            <p class="text-xs font-mono text-journalMuted uppercase tracking-wider">REFLECTIVE NOTES, WORK LOGS & COLLABORATIVE SCRATCHPADS</p>
        </div>

        <!-- Sample Interactive Entry -->
        <article class="deckled-card space-y-6 hover-lift shadow-xl">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-journalBorder/40 pb-4">
                <div class="space-y-1">
                    <h2 class="font-display text-2xl font-bold text-journalText m-0">Initial Journal Spark</h2>
                    <span class="inline-block text-[10px] font-mono font-semibold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 px-2.5 py-0.5 rounded-full border border-indigo-500/20">
                        AESTHETIC UPGRADE & CORE ARCHITECTURE
                    </span>
                </div>
                <time class="text-xs font-mono text-journalMuted flex items-center gap-1.5">
                    <i class="far fa-calendar-alt text-indigo-500"></i>
                    February 21, 2026
                </time>
            </div>

            <div class="font-reading text-base text-journalMuted leading-relaxed space-y-4">
                <p>Today was incredibly productive! Launched the central tokens system and completed standardizations for all partial layouts including head, header nav, and editorial footers.</p>
                <p>I feel deeply content knowing the system matches our target personality: highly professional, warm, quietly credible, and built with modern 2026 aesthetics.</p>
            </div>

            <!-- Like & Comment Area -->
            <div class="pt-4 border-t border-journalBorder/40 flex flex-col gap-4">
                <div class="flex items-center gap-6">
                    <button id="likeBtn" class="flex items-center gap-2 text-xs font-mono font-bold text-journalMuted hover:text-red-500 transition-colors bg-journalSurfaceSoft px-3 py-1.5 rounded-xl border border-journalBorder">
                        <i class="far fa-heart text-sm" id="likeIcon"></i> Like (<span id="likeCount">0</span>)
                    </button>
                    <button onclick="focusCommentInput()" class="flex items-center gap-2 text-xs font-mono font-bold text-journalMuted hover:text-indigo-500 transition-colors bg-journalSurfaceSoft px-3 py-1.5 rounded-xl border border-journalBorder">
                        <i class="far fa-comment text-sm"></i> Comment
                    </button>
                </div>

                <!-- Live comments container -->
                <div id="commentsWrapper" class="space-y-3 pt-2 divide-y divide-journalBorder/30">
                    <div class="text-xs space-y-1 pt-2 first:pt-0">
                        <span class="font-bold text-indigo-600 dark:text-indigo-400">Guest Reader:</span>
                        <p class="text-journalMuted font-reading leading-normal">
                            "Absolutely love this gorgeous, clean layout! It feels incredibly tactile, fast and eye-soothing."
                        </p>
                    </div>
                </div>

                <!-- Comment submission area -->
                <div class="space-y-3 pt-2" id="commentBox">
                    <textarea id="commentText" placeholder="Write an encouraging comment or feedback..."
                              class="w-full text-xs font-body bg-journalSurface border border-journalBorder rounded-xl p-3 focus:outline-none focus:border-indigo-500 text-journalText placeholder:text-journalMuted transition-colors shadow-inner h-20 resize-none"></textarea>
                    <button onclick="postComment()" class="btn-primary text-xs py-2 px-5">
                        Post Comment
                    </button>
                </div>
            </div>
        </article>

    </main>

    <%- include('partials/footer') %>

    <script>
        const backendUrl = window.location.origin;

        // Interactive like toggle
        let liked = false;
        let count = 0;
        const likeBtn = document.getElementById('likeBtn');
        const likeIcon = document.getElementById('likeIcon');
        const likeCount = document.getElementById('likeCount');

        if (likeBtn) {
            likeBtn.addEventListener('click', () => {
                liked = !liked;
                if (liked) {
                    count++;
                    likeIcon.className = 'fas fa-heart text-red-500';
                    likeBtn.classList.add('text-red-500');
                } else {
                    count--;
                    likeIcon.className = 'far fa-heart';
                    likeBtn.classList.remove('text-red-500');
                }
                likeCount.innerText = count;
            });
        }

        function focusCommentInput() {
            const input = document.getElementById('commentText');
            if (input) {
                input.focus();
            }
        }

        function postComment() {
            const text = document.getElementById('commentText');
            const wrapper = document.getElementById('commentsWrapper');
            if (!text || !text.value.trim() || !wrapper) return;

            const div = document.createElement('div');
            div.className = 'text-xs space-y-1 pt-2.5';
            div.innerHTML = `
                <span class="font-bold text-indigo-600 dark:text-indigo-400">Anonymous Reader:</span>
                <p class="text-journalMuted font-reading">${text.value.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>
            `;
            wrapper.appendChild(div);
            text.value = '';
        }
    </script>

</body>
</html>

