<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<%- include('partials/head', { title: "Error - Neer's Chronicle" }) %>
<body class="bg-journalBg text-journalText font-body antialiased selection:bg-red-500/30 selection:text-journalText page-fade-in flex flex-col min-h-screen">

    <%- include('partials/nav') %>

    <main class="flex-1 flex items-center justify-center max-w-xl mx-auto px-6 py-16 w-full">
        <!-- Error Content Box -->
        <article class="glass-panel rounded-3xl p-8 space-y-6 text-center w-full shadow-2xl relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-32 h-32 bg-red-500/10 rounded-full blur-2xl"></div>
            <div class="space-y-3 relative z-10">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-500 mb-2">
                    <i class="fas fa-exclamation-triangle text-2xl animate-pulse"></i>
                </div>
                <h2 class="font-display text-2xl md:text-3xl font-extrabold text-journalText m-0">Something Went Amiss</h2>
                <div class="inline-block px-3 py-1 rounded-full bg-red-500/10 text-red-600 dark:text-red-400 text-[10px] font-mono tracking-wider">
                    CHRONICLE BOUNDARY DISRUPTION
                </div>
            </div>

            <p class="font-reading text-sm text-journalMuted italic bg-journalSurfaceSoft/80 p-5 rounded-2xl border border-journalBorder shadow-inner relative z-10">
                "<%= typeof error !== 'undefined' ? error : 'An unexpected error occurred while processing your request.' %>"
            </p>

            <div class="pt-4 border-t border-journalBorder flex flex-col sm:flex-row items-center justify-center gap-4 relative z-10">
                <a href="/home" class="btn-primary py-2.5 px-6 rounded-xl text-xs font-mono uppercase tracking-wider font-semibold shadow-md flex items-center gap-2">
                    <i class="fas fa-home text-xs"></i> Return Home
                </a>
                <a href="/login" class="bg-journalSurface border border-journalBorder hover:border-indigo-500 hover:text-indigo-500 text-journalText py-2.5 px-6 rounded-xl text-xs font-mono uppercase tracking-wider font-semibold transition-all hover-lift flex items-center gap-2">
                    <i class="fas fa-sign-in-alt text-xs"></i> Log In
                </a>
            </div>
        </article>
    </main>

    <%- include('partials/footer') %>

</body>
</html>

