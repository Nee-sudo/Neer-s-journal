<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<%- include('partials/head', { title: "Neer's Friends - Trusted Circle" }) %>
<body class="bg-journalBg text-journalText font-body antialiased selection:bg-teal-500/30 selection:text-journalText page-fade-in min-h-screen flex flex-col justify-between">

    <%- include('partials/nav') %>

    <main class="max-w-7xl mx-auto px-6 py-12 space-y-16 flex-1 w-full">

        <!-- Page Header -->
        <div class="border-b border-journalBorder pb-6 space-y-2 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-1">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-600 dark:text-teal-400 text-xs font-mono">
                    <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
                    REGISTRY & CIRCLE
                </div>
                <h1 class="font-display text-3xl md:text-4xl font-extrabold text-journalText flex items-center gap-3">
                    <i class="fas fa-users text-teal-500"></i> Trusted Circle
                </h1>
                <p class="text-xs font-mono text-journalMuted uppercase tracking-wider">A REGISTRY OF THOUGHTFUL COMPANIONS & CO-CONSPIRATORS IN LIFE</p>
            </div>
            <% if (typeof canWrite !== 'undefined' && canWrite) { %>
            <button id="addFriendBtn" class="btn-primary self-start md:self-auto">
                <i class="fas fa-user-plus text-xs"></i> Be Neer's Friend
            </button>
            <% } %>
        </div>

        <!-- Banner Accent -->
        <section class="relative h-[250px] md:h-[320px] w-full rounded-3xl overflow-hidden shadow-xl border border-journalBorder">
            <div class="absolute inset-0 bg-cover bg-center" 
                 style="background-image: linear-gradient(to right, rgba(11,15,25,0.9) 0%, rgba(11,15,25,0.5) 100%), url('/img/connect.jpg');"></div>
            <div class="absolute inset-0 flex flex-col justify-center p-8 md:p-12 space-y-3 max-w-2xl text-left">
                <span class="text-xs font-mono uppercase tracking-widest text-teal-300">FRIENDSHIP REGISTRY</span>
                <h2 class="font-display text-2xl md:text-4xl font-extrabold text-white leading-tight">Shared Perspectives & Lifelong Connections</h2>
                <p class="text-xs md:text-sm font-reading text-slate-300 max-w-md">Every companion documented here brings distinct perspectives, critical feedback, and warm support to Neeraj's path.</p>
            </div>
        </section>

        <!-- Dynamically Loaded Friends Grid -->
        <section class="space-y-6">
            <div class="flex items-center gap-2 pb-2 border-b border-journalBorder">
                <span class="w-2.5 h-2.5 rounded-full bg-teal-500"></span>
                <h2 class="font-display text-lg font-bold uppercase tracking-wider text-journalText m-0">
                    Chronological Roll
                </h2>
            </div>
            
            <div id="friends" class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Injected dynamically -->
            </div>
        </section>

    </main>

    <%- include('partials/footer') %>

    <script>
        const backendUrl = window.location.origin;

        // Redirect to form
        const addFriendBtn = document.getElementById('addFriendBtn');
        if (addFriendBtn) {
            addFriendBtn.addEventListener('click', () => {
                window.location.href = "/friends-form";
            });
        }

        async function fetchFriends() {
            try {
                const response = await fetch('/friends');
                const friends = await response.json();
                const container = document.getElementById('friends');
                if (!container) return;

                if (!friends || friends.length === 0) {
                    container.innerHTML = `
                        <div class="md:col-span-3 text-center py-16 border border-dashed border-journalBorder rounded-3xl bg-journalSurface/50 space-y-3">
                            <div class="w-12 h-12 rounded-full bg-teal-500/10 text-teal-500 flex items-center justify-center mx-auto text-xl">
                                <i class="fas fa-users"></i>
                            </div>
                            <p class="text-sm font-reading text-journalMuted">Your circle is currently empty. Introduce a companion above.</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = '';
                friends.forEach((friend) => {
                    const card = document.createElement('div');
                    card.className = "deckled-card flex flex-col justify-between space-y-4 hover:border-teal-500/50 hover-lift";
                    
                    const dateStr = friend.joinDate ? new Date(friend.joinDate).toDateString() : 'Not specified';
                    
                    card.innerHTML = `
                        <div class="space-y-4">
                            <div class="flex items-center gap-3.5">
                                <img src="${friend.profilePicture || '/img/friend-placeholder.jpg'}" 
                                     alt="${friend.name}" class="w-14 h-14 rounded-2xl object-cover border border-journalBorder shadow-sm">
                                <div class="space-y-1">
                                    <h3 class="font-display font-bold text-base text-journalText m-0 leading-tight">${friend.name}</h3>
                                    <span class="inline-block text-[10px] font-mono font-semibold bg-teal-500/10 text-teal-600 dark:text-teal-400 px-2.5 py-0.5 rounded-md border border-teal-500/20">${friend.jobCategory || 'Friend'}</span>
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-2 gap-2 text-xs font-mono text-journalMuted bg-journalSurfaceSoft p-3 rounded-xl">
                                <div>
                                    <span class="text-[10px] text-journalMuted uppercase block">Origin</span>
                                    <span class="font-semibold text-journalText">${friend.country || 'Not specified'}</span>
                                </div>
                                <div>
                                    <span class="text-[10px] text-journalMuted uppercase block">Mindset</span>
                                    <span class="font-semibold text-journalText">${friend.personality || 'Not specified'}</span>
                                </div>
                                <div>
                                    <span class="text-[10px] text-journalMuted uppercase block">Gender</span>
                                    <span class="font-semibold text-journalText">${friend.gender || 'Not specified'}</span>
                                </div>
                                <div>
                                    <span class="text-[10px] text-journalMuted uppercase block">Joined</span>
                                    <span class="font-semibold text-journalText">${dateStr}</span>
                                </div>
                            </div>
                        </div>

                        <blockquote class="text-xs font-reading text-journalMuted italic bg-journalSurface/50 p-3 rounded-xl border border-journalBorder/40 leading-relaxed">
                            "${friend.thoughts}"
                        </blockquote>
                    `;
                    container.appendChild(card);
                });
            } catch (error) {
                console.error('Error fetching friends:', error);
            }
        }

        document.addEventListener('DOMContentLoaded', fetchFriends);
    </script>

</body>
</html>

