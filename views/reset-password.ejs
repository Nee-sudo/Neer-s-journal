<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<%- include('partials/head', { title: "Reset Credentials — Neer's Journal" }) %>
<body class="bg-journalBg text-journalText font-body antialiased selection:bg-indigo-500/30 selection:text-journalText page-fade-in min-h-screen flex flex-col justify-between">

    <header class="w-full py-6 border-b border-journalBorder/60">
        <div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
            <span class="font-display font-extrabold text-lg tracking-wider text-journalText flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
                NEER'S JOURNAL
            </span>
            <a href="/login" class="text-xs font-mono text-journalMuted hover:text-indigo-500 transition-colors flex items-center gap-1.5">
                <i class="fas fa-arrow-left"></i> Back to login
            </a>
        </div>
    </header>

    <main class="flex-grow flex items-center justify-center py-12 px-6">
        <div class="glass-panel w-full max-w-md p-8 space-y-6 rounded-3xl shadow-2xl relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-32 h-32 bg-indigo-500/10 rounded-full blur-2xl"></div>
            
            <div class="text-center space-y-2 relative z-10">
                <div class="w-14 h-14 bg-indigo-500/10 text-indigo-500 rounded-2xl border border-indigo-500/20 flex items-center justify-center text-2xl mx-auto mb-3 shadow-inner">
                    <i class="fas fa-key"></i>
                </div>
                <h2 class="font-display text-2xl font-bold text-journalText m-0">Establish New Password</h2>
                <p class="text-xs text-journalMuted font-mono">ENTER NEW ACCESS SECRET SECURELY</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 rounded-xl p-3.5 text-xs flex items-center gap-2.5">
                    <i class="fas fa-exclamation-circle text-sm shrink-0"></i>
                    <span class="font-semibold"><%= error %></span>
                </div>
            <% } %>

            <form action="/reset-password/<%= token %>" method="POST" class="space-y-5 relative z-10" onsubmit="return validatePasswords(this);">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="space-y-2">
                    <label for="password" class="text-xs font-mono font-bold text-journalText flex items-center gap-1.5 uppercase tracking-wider">
                        <i class="fas fa-lock text-indigo-500"></i> New Password
                    </label>
                    <input type="password" id="password" name="password" placeholder="••••••••" required
                           class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-3 focus:outline-none focus:border-indigo-500 text-journalText placeholder:text-journalMuted transition-colors shadow-inner">
                </div>

                <div class="space-y-2">
                    <label for="confirmPassword" class="text-xs font-mono font-bold text-journalText flex items-center gap-1.5 uppercase tracking-wider">
                        <i class="fas fa-check-double text-indigo-500"></i> Confirm Password
                    </label>
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required
                           class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-3 focus:outline-none focus:border-indigo-500 text-journalText placeholder:text-journalMuted transition-colors shadow-inner">
                </div>

                <div id="passwordMismatch" class="hidden bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 rounded-xl p-3.5 text-xs flex items-center gap-2.5">
                    <i class="fas fa-exclamation-triangle text-sm shrink-0"></i>
                    <span>Passwords do not match. Please ensure both fields are identical.</span>
                </div>

                <button type="submit" class="w-full btn-primary py-3.5 rounded-xl font-bold text-sm shadow-md">
                    Update Access Secret
                </button>
            </form>
        </div>
    </main>

    <footer class="w-full py-6 border-t border-journalBorder/60 text-center">
        <p class="text-[10px] font-mono text-journalMuted uppercase tracking-widest">&copy; 2026 Neer's Journal. Secured Container Protocol.</p>
    </footer>

    <script>
        function validatePasswords(form) {
            const pw = form.password.value;
            const confirm = form.confirmPassword.value;
            const mismatchDiv = document.getElementById('passwordMismatch');
            if (pw !== confirm) {
                mismatchDiv.classList.remove('hidden');
                return false;
            }
            mismatchDiv.classList.add('hidden');
            return true;
        }
    </script>
</body>
</html>

