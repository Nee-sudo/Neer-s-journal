<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<%- include('partials/head', { title: "Introduce Friend - Trusted Circle" }) %>
<body class="bg-journalBg text-journalText font-body antialiased selection:bg-teal-500/30 selection:text-journalText page-fade-in min-h-screen flex flex-col justify-between">

    <%- include('partials/nav') %>

    <main class="max-w-2xl mx-auto px-6 py-12 space-y-8 flex-1 w-full">

        <!-- Header -->
        <div class="border-b border-journalBorder pb-6 space-y-2 text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-600 dark:text-teal-400 text-xs font-mono">
                <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
                TRUSTED CIRCLE REGISTRATION
            </div>
            <h1 class="font-display text-3xl md:text-4xl font-extrabold text-journalText flex items-center justify-center gap-3">
                <i class="fas fa-user-plus text-teal-500"></i> Be Neer's Friend
            </h1>
            <p class="text-xs font-mono text-journalMuted uppercase tracking-wider">REGISTER YOUR PROFILE & SHARED WORDS ON THE JOURNAL</p>
        </div>

        <!-- Form Box -->
        <div class="glass-panel p-6 md:p-8 space-y-6 rounded-3xl shadow-xl">
            <% if (error) { %>
                <div class="bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 rounded-xl p-4 text-xs font-mono flex items-center gap-2">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/neers-friends" method="POST" class="space-y-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label for="name" class="text-xs font-mono font-bold uppercase tracking-wider text-journalText">Full Name</label>
                        <input type="text" id="name" name="name" required placeholder="e.g. Liam Sterling"
                               class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-2.5 focus:outline-none focus:border-teal-500 text-journalText placeholder:text-journalMuted transition-colors shadow-inner">
                    </div>
                    <div class="space-y-1.5">
                        <label for="joinDate" class="text-xs font-mono font-bold uppercase tracking-wider text-journalText">Joined Date</label>
                        <input type="date" id="joinDate" name="joinDate" required
                               class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-2.5 focus:outline-none focus:border-teal-500 text-journalText transition-colors shadow-inner">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label for="jobCategory" class="text-xs font-mono font-bold uppercase tracking-wider text-journalText">Job Field</label>
                        <select id="jobCategory" name="jobCategory" required
                                class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-3 py-2.5 focus:outline-none focus:border-teal-500 text-journalText transition-colors shadow-inner">
                            <option value="">Select Job Field</option>
                            <option value="Engineer">Engineer</option>
                            <option value="Designer">Designer</option>
                            <option value="Teacher">Teacher</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="space-y-1.5">
                        <label for="country" class="text-xs font-mono font-bold uppercase tracking-wider text-journalText">Country</label>
                        <select id="country" name="country" required
                                class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-3 py-2.5 focus:outline-none focus:border-teal-500 text-journalText transition-colors shadow-inner">
                            <option value="">Select Country</option>
                            <option value="India">India</option>
                            <option value="USA">USA</option>
                            <option value="Russia">Russia</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label for="gender" class="text-xs font-mono font-bold uppercase tracking-wider text-journalText">Gender</label>
                        <select id="gender" name="gender" required
                                class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-3 py-2.5 focus:outline-none focus:border-teal-500 text-journalText transition-colors shadow-inner">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="space-y-1.5">
                        <label for="personality" class="text-xs font-mono font-bold uppercase tracking-wider text-journalText">Personality Mindset</label>
                        <select id="personality" name="personality" required
                                class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-3 py-2.5 focus:outline-none focus:border-teal-500 text-journalText transition-colors shadow-inner">
                            <option value="">Select Personality</option>
                            <option value="Creative">Creative</option>
                            <option value="Analytical">Analytical</option>
                            <option value="Friendly">Friendly</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label for="profilePicture" class="text-xs font-mono font-bold uppercase tracking-wider text-journalText flex items-center gap-1"><i class="fas fa-link text-[10px]"></i> Avatar Image URL</label>
                    <input type="text" id="profilePicture" name="profilePicture" placeholder="/img/friend-placeholder.jpg"
                           class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-2.5 focus:outline-none focus:border-teal-500 text-journalText placeholder:text-journalMuted transition-colors shadow-inner">
                </div>

                <div class="space-y-1.5">
                    <label for="thoughts" class="text-xs font-mono font-bold uppercase tracking-wider text-journalText">Thoughts on Neeraj</label>
                    <textarea id="thoughts" name="thoughts" required placeholder="What are your thoughts or shared memories with Neeraj?"
                              class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-2.5 focus:outline-none focus:border-teal-500 text-journalText placeholder:text-journalMuted transition-colors shadow-inner h-28"></textarea>
                </div>

                <button type="submit" class="w-full btn-primary py-3.5 rounded-xl font-bold text-sm shadow-md flex items-center justify-center gap-2">
                    <i class="fas fa-paper-plane"></i> Submit Friendship Node
                </button>
            </form>

            <div class="text-center pt-2">
                <a href="/home" class="text-xs font-mono text-journalAccent font-bold hover:underline inline-flex items-center gap-1.5">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>

    </main>

    <%- include('partials/footer') %>

</body>
</html>

