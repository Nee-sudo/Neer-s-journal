<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<%- include('partials/head', { title: "Anonymous Message - Neer's Journey" }) %>
<body class="bg-journalBg text-journalText font-body antialiased selection:bg-cyan-500/30 selection:text-journalText page-fade-in min-h-screen flex flex-col justify-between">

    <%- include('partials/nav') %>

    <main class="max-w-2xl mx-auto px-6 py-12 space-y-8 flex-1 w-full">

        <!-- Header -->
        <div class="border-b border-journalBorder pb-6 space-y-2 text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-600 dark:text-cyan-400 text-xs font-mono">
                <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
                ANONYMOUS FEEDBACK & SCRATCHPAD
            </div>
            <h1 class="font-display text-3xl md:text-4xl font-extrabold text-journalText flex items-center justify-center gap-3">
                <i class="fas fa-paper-plane text-cyan-500"></i> Send Anonymous Message
            </h1>
            <p class="text-xs font-mono text-journalMuted uppercase tracking-wider">SHARE YOUR HONEST THOUGHTS, ENCOURAGEMENT, OR PRIVATE CRITIQUES</p>
        </div>

        <!-- Card Container -->
        <div class="glass-panel p-6 md:p-8 space-y-6 rounded-3xl shadow-xl">
            
            <% if (success) { %>
                <div class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 rounded-xl p-4 text-sm font-semibold flex items-center gap-2.5">
                    <i class="fas fa-check-circle text-lg text-emerald-500"></i>
                    <span><%= success %></span>
                </div>
            <% } %>

            <% if (error) { %>
                <div class="bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 rounded-xl p-4 text-sm font-semibold flex items-center gap-2.5">
                    <i class="fas fa-exclamation-circle text-lg text-red-500"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/send-message" method="POST" class="space-y-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="space-y-1.5">
                    <label for="name" class="text-xs font-mono font-bold uppercase tracking-wider text-journalText">Your Name (Optional)</label>
                    <input type="text" id="name" name="name" placeholder="e.g. Fellow Traveler (Leave empty for complete anonymity)"
                           class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-3 focus:outline-none focus:border-cyan-500 text-journalText placeholder:text-journalMuted transition-colors shadow-inner">
                </div>

                <div class="space-y-1.5">
                    <label for="message" class="text-xs font-mono font-bold uppercase tracking-wider text-journalText">Your Message</label>
                    <textarea id="message" name="message" required placeholder="Write your words here. Neeraj reads all messages with deep humility..."
                              class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-3 focus:outline-none focus:border-cyan-500 text-journalText placeholder:text-journalMuted transition-colors shadow-inner h-36"></textarea>
                </div>

                <button type="submit" class="w-full btn-primary py-3.5 rounded-xl font-bold text-sm shadow-md flex items-center justify-center gap-2">
                    <i class="fas fa-envelope"></i> Send Message
                </button>
            </form>

            <div class="text-center pt-2">
                <a href="/home" class="text-xs font-mono text-journalAccent font-bold hover:underline inline-flex items-center gap-1.5">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>

    </main>

    <%- include('partials/footer') %>

</body>
</html>

