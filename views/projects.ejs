<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<%- include('partials/head', { title: "Neer's Projects - Chronicle Labs" }) %>
<body class="bg-journalBg text-journalText font-body antialiased selection:bg-journalAccent/25 selection:text-journalText page-fade-in">

    <%- include('partials/nav') %>

    <main class="max-w-7xl mx-auto px-6 py-12 space-y-16">

        <!-- Header introduction -->
        <div class="border-b border-journalBorder pb-6 space-y-2">
            <h1 class="font-display text-3xl md:text-4xl font-bold flex items-center gap-3">
                <i class="fas fa-cubes text-journalAccent"></i> Chronicle Labs & Projects
            </h1>
            <p class="text-xs font-mono text-journalMuted uppercase tracking-wider">A COLLECTION OF PRACTICAL UTILITIES, WEB APPLICATIONS & COMMITTED SOCIAL INITIATIVES</p>
        </div>

        <!-- Banner Slider Accent -->
        <section class="relative h-[250px] md:h-[350px] w-full rounded-3xl overflow-hidden shadow-sm">
            <div class="absolute inset-0 bg-cover bg-center" 
                 style="background-image: linear-gradient(rgba(44,42,41,0.55), rgba(44,42,41,0.55)), url('/img/banner1.png');"></div>
            <div class="absolute inset-0 flex flex-col justify-center p-8 md:p-12 space-y-3 max-w-2xl text-left">
                <span class="text-xs font-mono uppercase tracking-widest text-journalAccent-light">CREATIVE EXPERIMENTS</span>
                <h2 class="font-display text-2xl md:text-4xl font-black text-white leading-tight">Solving Everyday Challenges through Minimal Code</h2>
                <p class="text-xs md:text-sm font-reading text-white/80 max-w-md">Each project is an answer to a real personal or local community issue, created using clean full-stack architectural pipelines.</p>
            </div>
        </section>

        <!-- Projects Bento / Columns -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-8">
            
            <!-- Badak_library Project Card -->
            <div class="deckled-card flex flex-col justify-between space-y-6">
                <div class="space-y-4">
                    <div class="relative rounded-xl overflow-hidden h-40 bg-journalSurface-soft border border-journalBorder flex items-center justify-center">
                        <img src="/img/badak_library.png" alt="Badak Library" class="w-full h-full object-cover filter grayscale sepia-[0.1] hover:grayscale-0 transition-all duration-300">
                    </div>
                    <div class="space-y-1">
                        <h3 class="font-display text-xl font-bold m-0 text-journalText">Badak_library</h3>
                        <p class="text-[10px] font-mono text-journalAccent uppercase">PDF DOCUMENT SHARING & PERSISTENCE</p>
                    </div>
                    <p class="text-sm font-reading text-journalMuted leading-relaxed">
                        A clean, intuitive PDF hosting platform that simplifies rapid document distribution. I engineered this tool so I could seamlessly upload slides and retrieve them across our university's computer science laboratories without repetitive authentication steps.
                    </p>
                </div>
                <div class="pt-4 border-t border-journalBorder/30">
                    <a href="https://badak-library.onrender.com/" target="_blank" rel="noopener"
                       class="inline-flex items-center gap-2 text-xs font-mono font-bold text-journalAccent hover:text-journalAccent-hover transition-colors">
                        VISIT DEPLOYMENT <i class="fas fa-external-link-alt text-[10px]"></i>
                    </a>
                </div>
            </div>

            <!-- Prayas Sankalp Project Card -->
            <div class="deckled-card flex flex-col justify-between space-y-6">
                <div class="space-y-4">
                    <div class="relative rounded-xl overflow-hidden h-40 bg-journalSurface-soft border border-journalBorder flex items-center justify-center">
                        <img src="/img/cozyfish.png" alt="Prayas Sankalp" class="w-full h-full object-cover filter grayscale sepia-[0.1] hover:grayscale-0 transition-all duration-300">
                    </div>
                    <div class="space-y-1">
                        <h3 class="font-display text-xl font-bold m-0 text-journalText">Prayas Sankalp</h3>
                        <p class="text-[10px] font-mono text-journalAccent uppercase">ALTRUISTIC PUBLIC FOOD DISPENSARY</p>
                    </div>
                    <p class="text-sm font-reading text-journalMuted leading-relaxed">
                        An interactive system targeting structural poverty and local food insecurity. Developed alongside colleagues for a collegiate innovation tournament, this portal coordinates leftover distribution to families requiring support.
                    </p>
                </div>
                <div class="pt-4 border-t border-journalBorder/30">
                    <a href="https://prayas-sankalp.onrender.com/signup-page-brown.html" target="_blank" rel="noopener"
                       class="inline-flex items-center gap-2 text-xs font-mono font-bold text-journalAccent hover:text-journalAccent-hover transition-colors">
                        VISIT DEPLOYMENT <i class="fas fa-external-link-alt text-[10px]"></i>
                    </a>
                </div>
            </div>

            <!-- Throw Your Text Project Card -->
            <div class="deckled-card flex flex-col justify-between space-y-6">
                <div class="space-y-4">
                    <div class="relative rounded-xl overflow-hidden h-40 bg-journalSurface-soft border border-journalBorder flex items-center justify-center">
                        <div class="text-center p-6 space-y-2">
                            <i class="fas fa-paper-plane text-4xl text-journalAccent/40"></i>
                            <p class="text-xs font-mono text-journalMuted">EPHEMERAL TEXT CLIPBOARD</p>
                        </div>
                    </div>
                    <div class="space-y-1">
                        <h3 class="font-display text-xl font-bold m-0 text-journalText">Throw Your Text</h3>
                        <p class="text-[10px] font-mono text-journalAccent uppercase">PASSWORDLESS SYNC BUFFER</p>
                    </div>
                    <p class="text-sm font-reading text-journalMuted leading-relaxed">
                        A lightweight ephemeral clipboard web engine created to exchange text strings between distinct local terminals instantly without requiring user profiles, secure authentications, or emailing oneself repetitive scratch messages.
                    </p>
                </div>
                <div class="pt-4 border-t border-journalBorder/30">
                    <a href="https://throw-your-text.onrender.com/" target="_blank" rel="noopener"
                       class="inline-flex items-center gap-2 text-xs font-mono font-bold text-journalAccent hover:text-journalAccent-hover transition-colors">
                        VISIT DEPLOYMENT <i class="fas fa-external-link-alt text-[10px]"></i>
                    </a>
                </div>
            </div>

        </section>

        <!-- Current Focus Info Box -->
        <section class="bg-journalSurface border border-journalBorder rounded-2xl p-6 md:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6 shadow-sm">
            <div class="space-y-2 max-w-xl">
                <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse"></span>
                    <span class="text-xs font-mono font-bold text-journalAccent uppercase tracking-wide">Ongoing Venture</span>
                </div>
                <h3 class="font-display text-lg font-bold">Integrating Intelligent Local Diagnostics</h3>
                <p class="text-xs md:text-sm font-reading text-journalMuted leading-relaxed">
                    I'm currently working on building specialized, sandboxed text processing workflows to summarize collegiate research papers, allowing quick extraction of essential arguments offline.
                </p>
            </div>
            <a href="/diary" class="bg-journalAccent hover:bg-journalAccent-hover text-white px-5 py-3 rounded-full text-xs font-mono uppercase tracking-wider font-semibold transition-all hover-lift self-start md:self-auto inline-flex items-center gap-2 text-center shadow-sm">
                <i class="fas fa-edit"></i> Check My Diary
            </a>
        </section>

    </main>

    <%- include('partials/footer') %>

</body>
</html>
