<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<%- include('partials/head', { title: "Search Results - Neer's Chronicle" }) %>
<body class="bg-journalBg text-journalText font-body antialiased selection:bg-journalAccent/25 selection:text-journalText page-fade-in">

    <%- include('partials/nav') %>

    <%
    function getMoodEmoji(mood) {
        const emojis = { Sad: '😢', Okay: '😐', Good: '😊', Great: '😃', Loved: '❤️' };
        return emojis[mood] || '😐';
    }
    %>

    <main class="max-w-7xl mx-auto px-6 py-12 space-y-16">

        <!-- Page Header -->
        <div class="border-b border-journalBorder pb-6 space-y-2 text-center md:text-left">
            <h1 class="font-display text-3xl md:text-4xl font-bold flex items-center justify-center md:justify-start gap-3">
                <i class="fas fa-search text-journalAccent"></i> Chronicle Search
            </h1>
            <p class="text-xs font-mono text-journalMuted uppercase tracking-wider">FOUND MATCHES FOR QUERY: "<%= query %>"</p>
        </div>

        <!-- Journals Results -->
        <% if (entries && entries.length > 0) { %>
            <section class="space-y-6">
                <div class="border-b border-journalBorder/30 pb-2">
                    <h2 class="font-display text-xl font-bold flex items-center gap-2">
                        <i class="fas fa-book text-journalAccent text-lg"></i> Matching Journal Entries
                    </h2>
                </div>
                
                <!-- Scrollable Journal Cards Grid with custom snap -->
                <div class="relative group">
                    <div class="flex gap-6 overflow-x-auto pb-6 scroll-smooth snap-x snap-mandatory scrollbar-none">
                        <% entries.forEach(entry => { %>
                            <div class="snap-start shrink-0 w-[290px] md:w-[350px] bg-journalSurface border border-journalBorder rounded-2xl p-6 flex flex-col justify-between space-y-4 hover:shadow-md transition-all duration-300 relative"
                                 style="background-color: <%= entry.boxColor || 'var(--color-surface)' %>;">
                                
                                <div class="space-y-2">
                                    <h3 class="font-display font-bold text-lg md:text-xl m-0 leading-tight" 
                                        style="color: <%= entry.headingColor || 'var(--color-text)' %>;">
                                        <%= entry.title %>
                                    </h3>
                                    <p class="text-[10px] font-mono text-journalMuted flex items-center gap-1.5">
                                        <i class="far fa-calendar"></i>
                                        <%= entry.createdAt ? new Date(entry.createdAt).toDateString() : 'Not specified' %>
                                    </p>
                                    <p class="text-xs font-mono text-journalMuted flex items-center gap-1.5">
                                        <span>Mood:</span>
                                        <span class="bg-journalSurface/50 backdrop-blur-sm border border-journalBorder/40 px-2 py-0.5 rounded-full text-[10px] font-semibold text-journalText">
                                            <%= entry.mood || 'Okay' %> <%= getMoodEmoji(entry.mood) %>
                                        </span>
                                    </p>
                                </div>

                                <div class="ql-editor font-reading text-sm leading-relaxed overflow-hidden max-h-[140px] relative text-journalText"
                                     style="color: <%= entry.contentColor || 'var(--color-text)' %>;">
                                    <%- entry.content %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- Friends Results -->
        <% if (friends && friends.length > 0) { %>
            <section class="space-y-6">
                <div class="border-b border-journalBorder/30 pb-2">
                    <h2 class="font-display text-xl font-bold flex items-center gap-2">
                        <i class="fas fa-users text-journalAccent text-lg"></i> Matching Friends
                    </h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% friends.forEach(friend => { %>
                        <article class="deckled-card flex flex-col space-y-4 hover-lift">
                            <div class="h-52 w-full overflow-hidden rounded-xl bg-journalSurface border border-journalBorder/30 relative">
                                <img src="<%= friend.profilePicture || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=800' %>" 
                                     alt="<%= friend.name %>" 
                                     class="w-full h-full object-cover"
                                     onerror="this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=800'">
                                <div class="absolute bottom-3 left-3 bg-journalSurface/95 backdrop-blur-sm border border-journalBorder px-2.5 py-1 rounded-full text-[10px] font-mono tracking-wider font-semibold text-journalText">
                                    <%= friend.jobCategory || 'Companion' %>
                                </div>
                            </div>

                            <div class="space-y-3">
                                <div class="space-y-1">
                                    <h3 class="font-display font-bold text-xl text-journalText"><%= friend.name %></h3>
                                    <div class="flex flex-wrap gap-2 text-[10px] font-mono text-journalMuted">
                                        <span><i class="fas fa-map-marker-alt text-journalAccent"></i> <%= friend.country || 'International' %></span>
                                        <span>•</span>
                                        <span><i class="fas fa-fingerprint text-journalAccent"></i> <%= friend.personality || 'Unknown' %></span>
                                    </div>
                                </div>

                                <blockquote class="font-reading text-sm text-journalMuted italic bg-journalSurface-soft/30 p-4 rounded-lg border border-journalBorder/30">
                                    "<%= friend.thoughts || 'No written thoughts shared yet.' %>"
                                </blockquote>

                                <div class="text-[10px] font-mono text-journalMuted flex items-center justify-between border-t border-journalBorder/20 pt-2">
                                    <span>JOURNAL VISITATION</span>
                                    <span><%= friend.joinDate ? new Date(friend.joinDate).toLocaleDateString() : 'Unspecified' %></span>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </section>
        <% } %>

        <!-- Empty/No Results State -->
        <% if ((!entries || entries.length === 0) && (!friends || friends.length === 0)) { %>
            <section class="max-w-2xl mx-auto py-16">
                <div class="deckled-card space-y-6 text-center">
                    <div class="space-y-2">
                        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-journalAccent/10 text-journalAccent mb-2">
                            <i class="fas fa-search-minus text-xl"></i>
                        </div>
                        <h2 class="font-display text-2xl font-bold text-journalText">No chronicle matches found</h2>
                        <p class="text-xs font-mono text-journalMuted uppercase tracking-wider">QUERY MISSED INDICES</p>
                    </div>

                    <p class="font-reading text-sm text-journalMuted italic max-w-md mx-auto">
                        "Your search for '<%= query %>' yielded no matching journals or registered companions. Try searching with more general keywords or return to home."
                    </p>

                    <div class="pt-4 border-t border-journalBorder/30 flex items-center justify-center">
                        <a href="/home" class="bg-journalAccent hover:bg-journalAccent-hover text-white py-2 px-5 rounded-lg text-xs font-mono uppercase tracking-wider font-semibold transition-all hover-lift shadow-sm flex items-center gap-2">
                            <i class="fas fa-arrow-left text-xs"></i> Back to Home
                        </a>
                    </div>
                </div>
            </section>
        <% } %>

    </main>

    <%- include('partials/footer') %>

</body>
</html>
