<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<%- include('partials/head', { title: "Neer's Chronicle - Inner Journal" }) %>
<body class="bg-journalBg text-journalText font-body antialiased selection:bg-indigo-500/30 selection:text-journalText page-fade-in min-h-screen flex flex-col justify-between">

    <%- include('partials/nav') %>

    <%
    function getMoodEmoji(mood) {
        const emojis = { Sad: '😢', Okay: '😐', Good: '😊', Great: '😃', Loved: '❤️' };
        return emojis[mood] || '😐';
    }
    %>

    <main class="max-w-7xl mx-auto px-6 py-10 space-y-16 flex-1 w-full">

        <!-- Error Banner -->
        <% if (error) { %>
            <div class="bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 rounded-2xl p-4 text-sm flex items-center gap-3 shadow-sm">
                <i class="fas fa-exclamation-circle text-lg text-red-500"></i>
                <span class="font-semibold"><%= error %></span>
            </div>
        <% } %>

        <!-- Hero & Banner Carousel -->
        <section class="relative h-[320px] md:h-[420px] w-full rounded-3xl overflow-hidden shadow-xl border border-journalBorder group">
            <div class="banner-slide active absolute inset-0 bg-cover bg-center transition-opacity duration-1000 flex items-end p-8 md:p-12" 
                 style="background-image: linear-gradient(to top, rgba(11,15,25,0.92) 0%, rgba(11,15,25,0.4) 60%, rgba(11,15,25,0.1) 100%), url('/img/banner.jpeg');">
                <div class="space-y-3 max-w-2xl">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-500/30 text-indigo-300 text-xs font-mono">
                        <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
                        CHRONICLE VOLUME I • 2026 EDITION
                    </div>
                    <h2 class="font-display text-3xl md:text-5xl font-extrabold text-white leading-tight tracking-tight">
                        Welcome to My Personal Sanctuary
                    </h2>
                    <p class="text-slate-300 text-sm md:text-base font-reading max-w-lg">
                        A private space for deep writing, deliberate thinking, and tracking life's meaningful milestones.
                    </p>
                </div>
            </div>
            <div class="banner-slide absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0 flex items-end p-8 md:p-12" 
                 style="background-image: linear-gradient(to top, rgba(11,15,25,0.92) 0%, rgba(11,15,25,0.4) 60%, rgba(11,15,25,0.1) 100%), url('/img/banner1.png');">
                <div class="space-y-3 max-w-2xl">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/20 border border-purple-500/30 text-purple-300 text-xs font-mono">
                        <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
                        LABS & EXPERIMENTS
                    </div>
                    <h2 class="font-display text-3xl md:text-5xl font-extrabold text-white leading-tight tracking-tight">
                        Explore Creative Engineering
                    </h2>
                    <p class="text-slate-300 text-sm md:text-base font-reading max-w-lg">
                        Documenting systems, applications, and technical breakthroughs crafted with precision.
                    </p>
                </div>
            </div>
            <div class="banner-slide absolute inset-0 bg-cover bg-center transition-opacity duration-1000 opacity-0 flex items-end p-8 md:p-12" 
                 style="background-image: linear-gradient(to top, rgba(11,15,25,0.92) 0%, rgba(11,15,25,0.4) 60%, rgba(11,15,25,0.1) 100%), url('/img/connect.jpg');">
                <div class="space-y-3 max-w-2xl">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 text-xs font-mono">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        AUTHENTIC CONNECTION
                    </div>
                    <h2 class="font-display text-3xl md:text-5xl font-extrabold text-white leading-tight tracking-tight">
                        Connect & Collaborate
                    </h2>
                    <p class="text-slate-300 text-sm md:text-base font-reading max-w-lg">
                        Building genuine relationships and offering support to fellow builders along the path.
                    </p>
                </div>
            </div>
        </section>

        <!-- Stats Overview Bar -->
        <section class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="glass-panel p-5 rounded-2xl flex items-center gap-4 hover-lift">
                <div class="w-12 h-12 rounded-xl gradient-bg-primary flex items-center justify-center text-white text-lg shadow-md shadow-indigo-500/20">
                    <i class="fas fa-book-open"></i>
                </div>
                <div>
                    <span class="text-xs font-mono text-journalMuted uppercase font-semibold">Journal Pages</span>
                    <h3 class="font-display text-2xl font-bold text-journalText m-0"><%= entries ? entries.length : 0 %></h3>
                </div>
            </div>

            <div class="glass-panel p-5 rounded-2xl flex items-center gap-4 hover-lift">
                <div class="w-12 h-12 rounded-xl gradient-bg-teal flex items-center justify-center text-white text-lg shadow-md shadow-teal-500/20">
                    <i class="fas fa-user-friends"></i>
                </div>
                <div>
                    <span class="text-xs font-mono text-journalMuted uppercase font-semibold">Circle Nodes</span>
                    <h3 class="font-display text-2xl font-bold text-journalText m-0"><%= friends ? friends.length : 0 %></h3>
                </div>
            </div>

            <div class="glass-panel p-5 rounded-2xl flex items-center gap-4 hover-lift">
                <div class="w-12 h-12 rounded-xl gradient-bg-purple-pink flex items-center justify-center text-white text-lg shadow-md shadow-pink-500/20">
                    <i class="fas fa-heart"></i>
                </div>
                <div>
                    <span class="text-xs font-mono text-journalMuted uppercase font-semibold">Impact Logs</span>
                    <h3 class="font-display text-2xl font-bold text-journalText m-0"><%= lifeSaved ? lifeSaved.length : 0 %></h3>
                </div>
            </div>

            <div class="glass-panel p-5 rounded-2xl flex items-center gap-4 hover-lift">
                <div class="w-12 h-12 rounded-xl bg-amber-500 flex items-center justify-center text-white text-lg shadow-md shadow-amber-500/20">
                    <i class="fas fa-star"></i>
                </div>
                <div>
                    <span class="text-xs font-mono text-journalMuted uppercase font-semibold">Key Idols</span>
                    <h3 class="font-display text-2xl font-bold text-journalText m-0">4</h3>
                </div>
            </div>
        </section>

        <!-- Journal Section -->
        <section id="journal" class="space-y-6 scroll-mt-24">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-journalBorder pb-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
                        <h2 class="font-display text-2xl md:text-3xl font-extrabold text-journalText m-0">
                            Private Journal
                        </h2>
                    </div>
                    <p class="text-xs font-mono text-journalMuted">REFLECTIVE LOGS & DAILY THOUGHTS</p>
                </div>
                <% if (typeof canWrite !== 'undefined' && canWrite) { %>
                <button onclick="openEditor()" class="btn-primary self-start sm:self-auto">
                    <i class="fas fa-pen-nib text-xs"></i> New Entry
                </button>
                <% } %>
            </div>

            <!-- Scrollable Journal Cards Grid -->
            <div class="relative group">
                <div id="journalSlider" class="flex gap-6 overflow-x-auto pb-6 scroll-smooth snap-x snap-mandatory scrollbar-none">
                    <% if (entries && entries.length > 0) { %>
                        <% entries.forEach(entry => { %>
                            <div class="snap-start shrink-0 w-[300px] md:w-[360px] bg-journalSurface border border-journalBorder rounded-2xl p-6 flex flex-col justify-between space-y-4 hover:border-indigo-500/50 hover:shadow-xl transition-all duration-300 relative group/card"
                                 style="background-color: <%= entry.boxColor || 'var(--color-surface)' %>;">
                                
                                <!-- Card Header -->
                                <div class="space-y-3">
                                    <div class="flex items-start justify-between gap-3">
                                        <h3 class="font-display font-bold text-lg md:text-xl m-0 leading-snug" 
                                            style="color: <%= entry.headingColor || 'var(--color-text)' %>;">
                                            <%= entry.title %>
                                        </h3>
                                        <% if (typeof canWrite !== 'undefined' && canWrite) { %>
                                        <button onclick="deleteEntry('<%= entry._id %>')" 
                                                class="text-xs text-red-500/50 hover:text-red-500 transition-colors p-1.5 rounded-lg hover:bg-red-500/10 shrink-0" 
                                                title="Delete Entry" aria-label="Delete Entry">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                        <% } %>
                                    </div>
                                    <div class="flex items-center justify-between text-xs font-mono text-journalMuted pt-1">
                                        <span class="flex items-center gap-1.5">
                                            <i class="far fa-calendar-alt text-indigo-500"></i>
                                            <%= entry.createdAt ? new Date(entry.createdAt).toDateString() : 'Not specified' %>
                                        </span>
                                        <span class="bg-journalSurface/80 border border-journalBorder px-2.5 py-0.5 rounded-full text-[11px] font-semibold text-journalText shadow-xs">
                                            <%= entry.mood || 'Okay' %> <%= getMoodEmoji(entry.mood) %>
                                        </span>
                                    </div>
                                </div>

                                <!-- Rich Content Preview -->
                                <div class="ql-editor font-reading text-sm leading-relaxed overflow-hidden max-h-[130px] relative text-journalText opacity-90"
                                     style="color: <%= entry.contentColor || 'var(--color-text)' %>;">
                                    <%- entry.content %>
                                </div>

                                <!-- Tags & Footer -->
                                <div class="space-y-3 pt-3 border-t border-journalBorder/30">
                                    <div class="flex flex-wrap gap-1.5">
                                        <% if (entry.tags && entry.tags.length > 0) { %>
                                            <% entry.tags.forEach(tag => { %>
                                                <span class="text-[10px] font-mono bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 px-2 py-0.5 rounded-md">#<%= tag %></span>
                                            <% }) %>
                                        <% } %>
                                    </div>
                                    <button onclick="openReadMoreModal(this.previousElementSibling.previousElementSibling.innerHTML)" 
                                            class="text-xs font-semibold text-journalAccent hover:text-journalAccent-hover flex items-center gap-1.5 transition-colors">
                                        <span>Read Full Entry</span>
                                        <i class="fas fa-arrow-right text-[10px] group-hover/card:translate-x-1 transition-transform"></i>
                                    </button>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="w-full text-center py-16 border border-dashed border-journalBorder rounded-3xl bg-journalSurface/50 space-y-3">
                            <div class="w-12 h-12 rounded-full bg-indigo-500/10 text-indigo-500 flex items-center justify-center mx-auto text-xl">
                                <i class="fas fa-pen"></i>
                            </div>
                            <p class="text-sm font-reading text-journalMuted">Your chronicle is currently empty.</p>
                            <% if (typeof canWrite !== 'undefined' && canWrite) { %>
                            <button onclick="openEditor()" class="btn-primary text-xs">
                                Create Entry
                            </button>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- Idols / Mentors Section -->
        <section id="idols" class="space-y-6 scroll-mt-24">
            <div class="flex items-center justify-between border-b border-journalBorder pb-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                        <h2 class="font-display text-2xl md:text-3xl font-extrabold text-journalText m-0">
                            Key Idols & Mentors
                        </h2>
                    </div>
                    <p class="text-xs font-mono text-journalMuted">THINKERS WHO SHAPE INTELLECT & MINDSET</p>
                </div>
                <span class="text-xs font-mono text-journalMuted hidden sm:inline">INSPIRATIONS</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Idol 1 (Osho) -->
                <div class="deckled-card flex flex-col justify-between space-y-5 hover-lift">
                    <div class="space-y-4">
                        <div class="h-48 w-full overflow-hidden rounded-xl border border-journalBorder relative group/img">
                            <img src="/img/osho.jpg" 
                                 alt="Osho" class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-500">
                        </div>
                        <div class="space-y-2">
                            <h3 class="font-display text-lg font-bold text-journalText m-0">Osho</h3>
                            <blockquote class="text-xs font-mono text-indigo-600 dark:text-indigo-400 italic bg-indigo-500/5 p-3 rounded-lg border border-indigo-500/10 leading-relaxed">
                                "Don't be afraid of difficulties. The greater the difficulties, the more energy you will have to transform them."
                            </blockquote>
                        </div>
                        <p class="text-xs font-reading text-journalMuted leading-relaxed">
                            Whenever I feel overwhelmed, I listen to his dialogues. He speaks authentic truth about natural living.
                        </p>
                    </div>
                </div>

                <!-- Idol 2 (Ratan Tata) -->
                <div class="deckled-card flex flex-col justify-between space-y-5 hover-lift">
                    <div class="space-y-4">
                        <div class="h-48 w-full overflow-hidden rounded-xl border border-journalBorder relative group/img">
                            <img src="/img/ratan.jpg" 
                                 alt="Ratan Tata" class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-500">
                        </div>
                        <div class="space-y-2">
                            <h3 class="font-display text-lg font-bold text-journalText m-0">Ratan Tata</h3>
                            <blockquote class="text-xs font-mono text-indigo-600 dark:text-indigo-400 italic bg-indigo-500/5 p-3 rounded-lg border border-indigo-500/10 leading-relaxed">
                                "None can destroy iron, but its own rust can. Likewise, none can destroy a person, but his own mindset."
                            </blockquote>
                        </div>
                        <p class="text-xs font-reading text-journalMuted leading-relaxed">
                            Deeply influenced by his humility and his quiet dedication to national progress and philanthropy.
                        </p>
                    </div>
                </div>

                <!-- Idol 3 (Bill Gates) -->
                <div class="deckled-card flex flex-col justify-between space-y-5 hover-lift">
                    <div class="space-y-4">
                        <div class="h-48 w-full overflow-hidden rounded-xl border border-journalBorder relative group/img">
                            <img src="/img/bill.webp" 
                                 alt="Bill Gates" class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-500">
                        </div>
                        <div class="space-y-2">
                            <h3 class="font-display text-lg font-bold text-journalText m-0">Bill Gates</h3>
                            <blockquote class="text-xs font-mono text-indigo-600 dark:text-indigo-400 italic bg-indigo-500/5 p-3 rounded-lg border border-indigo-500/10 leading-relaxed">
                                "Your most unhappy customers are your greatest source of learning."
                            </blockquote>
                        </div>
                        <p class="text-xs font-reading text-journalMuted leading-relaxed">
                            Inspired by his voracious reading habits and systematic approach to global public health solutions.
                        </p>
                    </div>
                </div>

                <!-- Idol 4 (Zuckerberg) -->
                <div class="deckled-card flex flex-col justify-between space-y-5 hover-lift">
                    <div class="space-y-4">
                        <div class="h-48 w-full overflow-hidden rounded-xl border border-journalBorder relative group/img">
                            <img src="/img/zuck.jpg" 
                                 alt="Mark Zuckerberg" class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-500">
                        </div>
                        <div class="space-y-2">
                            <h3 class="font-display text-lg font-bold text-journalText m-0">Mark Zuckerberg</h3>
                            <blockquote class="text-xs font-mono text-indigo-600 dark:text-indigo-400 italic bg-indigo-500/5 p-3 rounded-lg border border-indigo-500/10 leading-relaxed">
                                "The biggest risk is not taking any risk. In a changing world, the only guaranteed strategy to fail is taking no risks."
                            </blockquote>
                        </div>
                        <p class="text-xs font-reading text-journalMuted leading-relaxed">
                            I respect his technical focus, long-term engineering vision, and speed of building.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Friends Section -->
        <section id="friends" class="space-y-6 scroll-mt-24">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-journalBorder pb-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-teal-500"></span>
                        <h2 class="font-display text-2xl md:text-3xl font-extrabold text-journalText m-0">
                            Trusted Circle
                        </h2>
                    </div>
                    <p class="text-xs font-mono text-journalMuted">COMPANIONS & FRIENDS MET ALONG THE ROAD</p>
                </div>
                <% if (typeof canWrite !== 'undefined' && canWrite) { %>
                <button onclick="openFriendForm()" class="btn-primary self-start sm:self-auto">
                    <i class="fas fa-user-plus text-xs"></i> Add Friend Node
                </button>
                <% } %>
            </div>

            <div class="relative group">
                <div id="friendsSlider" class="flex gap-6 overflow-x-auto pb-6 scroll-smooth snap-x snap-mandatory scrollbar-none">
                    <% if (friends && friends.length > 0) { %>
                        <% friends.forEach(friend => { %>
                            <div class="snap-start shrink-0 w-[290px] md:w-[320px] bg-journalSurface border border-journalBorder rounded-2xl p-6 space-y-4 hover:border-teal-500/50 hover:shadow-lg transition-all duration-300">
                                <div class="flex items-center gap-3.5">
                                    <img src="<%= friend.profilePicture || '/img/friend-placeholder.jpg' %>" 
                                         alt="<%= friend.name %>" class="w-12 h-12 rounded-2xl object-cover border border-journalBorder shadow-sm">
                                    <div class="space-y-0.5">
                                        <h3 class="font-display font-bold text-base text-journalText m-0 leading-tight"><%= friend.name %></h3>
                                        <span class="inline-block text-[10px] font-mono font-semibold bg-teal-500/10 text-teal-600 dark:text-teal-400 px-2 py-0.5 rounded-md border border-teal-500/20">
                                            <%= friend.jobCategory %>
                                        </span>
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-2 text-xs font-mono text-journalMuted bg-journalSurfaceSoft p-3 rounded-xl">
                                    <div>
                                        <span class="text-[10px] text-journalMuted uppercase block">Origin</span>
                                        <span class="font-semibold text-journalText"><%= friend.country %></span>
                                    </div>
                                    <div>
                                        <span class="text-[10px] text-journalMuted uppercase block">Mindset</span>
                                        <span class="font-semibold text-journalText"><%= friend.personality %></span>
                                    </div>
                                </div>
                                <blockquote class="text-xs font-reading text-journalMuted italic bg-journalSurface/50 p-3 rounded-xl border border-journalBorder/40 leading-relaxed">
                                    "<%= friend.thoughts %>"
                                </blockquote>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="w-full text-center py-16 border border-dashed border-journalBorder rounded-3xl bg-journalSurface/50 space-y-3">
                            <div class="w-12 h-12 rounded-full bg-teal-500/10 text-teal-500 flex items-center justify-center mx-auto text-xl">
                                <i class="fas fa-users"></i>
                            </div>
                            <p class="text-sm font-reading text-journalMuted">Your circle is currently empty.</p>
                            <% if (typeof canWrite !== 'undefined' && canWrite) { %>
                            <button onclick="openFriendForm()" class="btn-primary text-xs">
                                Add Companion
                            </button>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- Lives Saved / Impact Section -->
        <section id="life-saved" class="space-y-6 scroll-mt-24">
            <div class="flex items-center justify-between border-b border-journalBorder pb-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-pink-500"></span>
                        <h2 class="font-display text-2xl md:text-3xl font-extrabold text-journalText m-0">
                            Lives Saved & Impact
                        </h2>
                    </div>
                    <p class="text-xs font-mono text-journalMuted">CHRONICLED STORIES OF EMERGENCY AID & CARING</p>
                </div>
                <span class="text-xs font-mono text-journalMuted hidden sm:inline">SERVICE LOGS</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <% if (lifeSaved && lifeSaved.length > 0) { %>
                    <% lifeSaved.forEach(story => { %>
                        <div class="deckled-card space-y-6 flex flex-col justify-between hover-lift">
                            <div class="space-y-4">
                                <div class="h-56 w-full overflow-hidden rounded-xl border border-journalBorder relative">
                                    <img src="<%= story.photo %>" alt="<%= story.title %>" class="w-full h-full object-cover">
                                </div>
                                <div class="space-y-1">
                                    <h3 class="font-display text-xl font-bold text-journalText m-0"><%= story.title %></h3>
                                    <p class="text-[11px] font-mono text-indigo-500 font-semibold flex items-center gap-1.5">
                                        <i class="far fa-clock"></i>
                                        <%= story.date ? new Date(story.date).toDateString() : 'Not specified' %>
                                    </p>
                                </div>
                                <p class="text-sm font-reading text-journalMuted leading-relaxed">
                                    <%= story.description %>
                                </p>
                            </div>

                            <!-- Comments Section -->
                            <div class="border-t border-journalBorder/40 pt-4 space-y-3">
                                <h4 class="font-display text-xs font-bold text-journalText uppercase tracking-wider flex items-center gap-2">
                                    <i class="far fa-comments text-indigo-500"></i> Words & Thoughts (<%= story.comments ? story.comments.length : 0 %>)
                                </h4>
                                
                                <div class="space-y-2 max-h-[140px] overflow-y-auto pr-1 divide-y divide-journalBorder/30">
                                    <% if (story.comments && story.comments.length > 0) { %>
                                        <% story.comments.forEach(comment => { %>
                                            <div class="text-xs space-y-1 pt-2 first:pt-0">
                                                <div class="flex justify-between items-center">
                                                    <span class="font-semibold text-indigo-600 dark:text-indigo-400"><%= comment.user %></span>
                                                    <span class="text-[9px] font-mono text-journalMuted"><%= comment.createdAt ? new Date(comment.createdAt).toLocaleDateString() : '' %></span>
                                                </div>
                                                <p class="text-journalMuted font-reading leading-normal"><%= comment.content %></p>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <p class="text-xs font-mono text-journalMuted italic py-1">No comments posted yet.</p>
                                    <% } %>
                                </div>

                                <form action="/comment/<%= story._id %>" method="POST" class="space-y-2 pt-2">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <textarea name="content" placeholder="Share your words or encouragement..." required
                                              class="w-full text-xs font-body bg-journalSurface border border-journalBorder rounded-xl p-3 focus:outline-none focus:border-indigo-500 text-journalText placeholder:text-journalMuted transition-colors shadow-inner h-16 resize-none"></textarea>
                                    <button type="submit" class="btn-primary text-xs py-1.5 px-4">
                                        Post Word
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="md:col-span-2 text-center py-16 border border-dashed border-journalBorder rounded-3xl bg-journalSurface/50 space-y-2">
                        <i class="fas fa-heart text-4xl text-journalMuted"></i>
                        <p class="text-sm font-reading text-journalMuted">No emergency logs archived yet.</p>
                    </div>
                <% } %>
            </div>
        </section>

        <!-- Gallery Section -->
        <section id="photos" class="space-y-6 scroll-mt-24">
