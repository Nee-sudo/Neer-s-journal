    <!-- Create Journal Entry Editor Modal -->
    <div class="modal" id="editorModal" aria-hidden="true">
        <div class="modal-content max-w-2xl w-[95%] p-6 md:p-8 space-y-6 bg-journalSurface border border-journalBorder rounded-3xl relative shadow-2xl">
            <button onclick="closeModal('editorModal')" class="absolute top-6 right-6 text-journalMuted hover:text-journalAccent text-xl transition-colors p-2 rounded-xl border border-journalBorder" aria-label="Close Editor">
                <i class="fas fa-times"></i>
            </button>
            
            <div class="space-y-1">
                <h2 class="font-display text-xl md:text-2xl font-extrabold text-journalText flex items-center gap-2.5">
                    <i class="fas fa-pen-nib text-indigo-500"></i> Chronicle New Page
