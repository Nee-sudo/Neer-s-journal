                    <label for="tags" class="text-xs font-mono font-bold uppercase tracking-wider text-journalText flex items-center gap-1"><i class="fas fa-tags text-indigo-500"></i> Tags (Comma-separated)</label>
                    <input type="text" id="tags" name="tags" placeholder="e.g. architecture, mindfulness, code"
                           class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-3 focus:outline-none focus:border-indigo-500 text-journalText placeholder:text-journalMuted transition-colors shadow-inner">
                </div>

                <button type="submit" class="w-full btn-primary py-3.5 rounded-xl font-bold text-sm shadow-md flex items-center justify-center gap-2">
                    <i class="fas fa-cloud-upload-alt"></i> Save Chronicle Page
                </button>
            </form>
        </div>
