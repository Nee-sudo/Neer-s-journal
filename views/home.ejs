    <!-- Read More Journal Modal -->
    <div class="modal" id="readMoreModal" aria-hidden="true">
        <div class="modal-content max-w-2xl w-[95%] p-6 md:p-8 space-y-6 bg-journalSurface border border-journalBorder rounded-3xl relative shadow-2xl">
            <button onclick="closeModal('readMoreModal')" class="absolute top-6 right-6 text-journalMuted hover:text-journalAccent text-xl transition-colors p-2 rounded-xl border border-journalBorder" aria-label="Close View">
                <i class="fas fa-times"></i>
