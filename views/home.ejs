                        <button type="button" class="mood-btn px-3.5 py-1.5 border border-journalBorder rounded-xl text-xs font-semibold flex items-center gap-1.5 bg-journalSurface text-journalText hover:border-indigo-500 transition-all" data-mood="Great">Great 😃</button>
                        <button type="button" class="mood-btn px-3.5 py-1.5 border border-journalBorder rounded-xl text-xs font-semibold flex items-center gap-1.5 bg-journalSurface text-journalText hover:border-indigo-500 transition-all" data-mood="Loved">Loved ❤️</button>
