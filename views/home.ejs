    <%- include('partials/footer') %>

    <!-- Quill rich text editor loader and setup scripts -->
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <script>
    const csrfToken = '<%= csrfToken %>';
    const backendUrl = window.location.origin;

    // Custom inline functions exposed to click actions safely
    function openEditor() {
        document.getElementById('editorModal').classList.add('active');
        document.getElementById('editorModal').setAttribute('aria-hidden', 'false');
    }

    function openFriendForm() {
        document.getElementById('friendModal').classList.add('active');
        document.getElementById('friendModal').setAttribute('aria-hidden', 'false');
    }

    function closeModal(modalId) {
        document.getElementById(modalId).classList.remove('active');
        document.getElementById(modalId).setAttribute('aria-hidden', 'true');
    }

    function setColor(color) {
        const picker = document.getElementById('boxColor');
        if (picker) {
            picker.value = color;
        }
    }

    function openPhotoModal(src) {
        const modal = document.getElementById('photoModal');
        const img = document.getElementById('photoModalImg');
        if (modal && img) {
            img.src = src;
            modal.classList.add('active');
            modal.setAttribute('aria-hidden', 'false');
        }
    }

    function closePhotoModal() {
        const modal = document.getElementById('photoModal');
        const img = document.getElementById('photoModalImg');
        if (modal && img) {
            modal.classList.remove('active');
            modal.setAttribute('aria-hidden', 'true');
            img.src = '';
        }
    }

    function openReadMoreModal(content) {
        const modal = document.getElementById('readMoreModal');
        const view = document.getElementById('readMoreContent');
        if (modal && view) {
            view.innerHTML = content;
            modal.classList.add('active');
            modal.setAttribute('aria-hidden', 'false');
        }
    }

    // Call Delete Entry API
    async function deleteEntry(id) {
        if (!confirm('Are you sure you want to permanently delete this chronicle page?')) return;
        try {
            const res = await fetch(`${backendUrl}/api/deleteJournal/${id}`, {
                method: 'DELETE',
                headers: { 'CSRF-Token': csrfToken }
            });
            if (res.ok) {
                alert('Entry deleted successfully.');
                location.reload();
            } else {
                const err = await res.json();
                alert(`Error deleting entry: ${err.error || 'Unknown error'}`);
            }
        } catch (error) {
            alert('An error occurred. Unable to delete entry.');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Banner slider automatic rotating slideshow
        const slides = document.querySelectorAll('.banner-slide');
        let index = 0;
        if (slides.length > 1) {
            setInterval(() => {
                slides[index].classList.remove('active');
                slides[index].classList.add('opacity-0');
                index = (index + 1) % slides.length;
                slides[index].classList.add('active');
                slides[index].classList.remove('opacity-0');
            }, 6000);
        }

        // Quill rich text editor configurations
        const quill = new Quill('#editor', {
            theme: 'snow',
            modules: {
                toolbar: [
                    ['bold', 'italic', 'underline'],
                    [{ 'color': [] }, { 'background': [] }],
                    [{ 'align': [] }],
                    ['clean']
                ]
            }
        });

        // Mood buttons chips synchronization
        const moodBtns = document.querySelectorAll('.mood-btn');
        const moodInput = document.getElementById('mood');
        const defaultMoodBtn = document.querySelector('.mood-btn[data-mood="Okay"]');

        moodBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                moodBtns.forEach(b => {
                    b.classList.remove('gradient-bg-primary', 'text-white', 'border-transparent');
                    b.classList.add('bg-journalSurface', 'text-journalText');
                });
                this.classList.remove('bg-journalSurface', 'text-journalText');
                this.classList.add('gradient-bg-primary', 'text-white', 'border-transparent');
                moodInput.value = this.dataset.mood;
            });
        });

        if (defaultMoodBtn) {
            defaultMoodBtn.click();
        }

        // Handle Journal Saving form submit
        const journalForm = document.getElementById('journalForm');
        if (journalForm) {
            journalForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const contentText = quill.root.innerHTML;
                document.getElementById('content').value = contentText;

                const formData = new FormData(journalForm);
                const payload = {
                    title: formData.get('title'),
                    content: formData.get('content'),
                    headingColor: formData.get('headingColor'),
                    contentColor: formData.get('contentColor'),
                    boxColor: formData.get('boxColor'),
                    mood: formData.get('mood'),
                    tags: formData.get('tags') ? formData.get('tags').split(',').map(t => t.trim()).filter(t => t) : []
                };

                try {
                    const res = await fetch(`${backendUrl}/api/saveJournal`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'CSRF-Token': csrfToken
                        },
                        body: JSON.stringify(payload),
                        credentials: 'include'
                    });

                    const resData = await res.json();
                    if (res.ok) {
                        alert('Chronicle page saved successfully!');
                        closeModal('editorModal');
                        location.reload();
                    } else {
                        alert(`Failed to save journal: ${resData.error || 'Unknown error'}`);
                    }
                } catch (error) {
                    alert(`An error occurred. Unable to connect to server.`);
                }
            });
        }

        // Handle adding a new friend form submit
        const friendForm = document.getElementById('friendForm');
        if (friendForm) {
            friendForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(friendForm);

                try {
                    const res = await fetch(`${backendUrl}/neers-friends`, {
                        method: 'POST',
                        body: formData,
                        headers: { 'CSRF-Token': csrfToken },
                        credentials: 'include'
                    });
                    const resData = await res.json();
                    if (res.ok) {
                        alert('Friend node successfully added!');
                        closeModal('friendModal');
                        location.reload();
                    } else {
                        alert(`Failed to save friend: ${resData.error || 'Unknown error'}`);
                    }
                } catch (error) {
                    alert('An error occurred submitting friend data.');
                }
            });
        }

        // Handle comment forms submissions asynchronously
        document.querySelectorAll('form[action^="/comment/"]').forEach(form => {
            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(form);
                const url = form.getAttribute('action');

                try {
                    const res = await fetch(`${backendUrl}${url}`, {
                        method: 'POST',
                        body: formData,
                        headers: { 'CSRF-Token': csrfToken },
                        credentials: 'include'
                    });
                    if (res.ok) {
                        alert('Word posted successfully!');
                        location.reload();
                    } else {
                        alert('Failed to submit word.');
                    }
                } catch (error) {
                    alert('Connection issue. Comment not posted.');
                }
            });
        });

        // Close modals clicking outside bounding box
        document.querySelectorAll('.modal').forEach(modal => {
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    modal.classList.remove('active');
                    modal.setAttribute('aria-hidden', 'true');
                    if (modal.id === 'photoModal') closePhotoModal();
                }
            });
        });

        // Esc key closes modal overlays
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal.active').forEach(modal => {
                    modal.classList.remove('active');
                    modal.setAttribute('aria-hidden', 'true');
                });
                closePhotoModal();
            }
        });
    });
    </script>
</body>
</html>

