<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<%- include('partials/head', { title: "Inspirations & Heroes - Neer's Chronicle" }) %>
<body class="bg-journalBg text-journalText font-body antialiased selection:bg-purple-500/30 selection:text-journalText page-fade-in min-h-screen flex flex-col justify-between">

    <%- include('partials/nav') %>

    <main class="max-w-7xl mx-auto px-6 py-12 space-y-16 flex-1 w-full">

        <!-- Page Header -->
        <div class="border-b border-journalBorder pb-6 space-y-2 text-center md:text-left">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-600 dark:text-purple-400 text-xs font-mono">
                <span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse"></span>
                HEROES & MENTORS
            </div>
            <h1 class="font-display text-3xl md:text-4xl font-extrabold text-journalText flex items-center justify-center md:justify-start gap-3">
                <i class="fas fa-compass text-purple-500"></i> Lights of Inspiration
            </h1>
            <p class="text-xs font-mono text-journalMuted uppercase tracking-wider">HEROES, THINKERS & MENTORS INFLUENCING OUR LAB PATHS</p>
        </div>

        <!-- Custom/Database-driven Inspirations -->
        <% if (idols && idols.length > 0) { %>
            <section class="space-y-8">
                <div class="flex items-center gap-2 pb-2 border-b border-journalBorder">
                    <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
                    <h2 class="font-display text-xl font-bold text-journalText m-0">Saved Mentors</h2>
                    <span class="text-xs font-mono text-journalMuted uppercase tracking-wider">(Database Registry)</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% idols.forEach(idol => { %>
                        <article class="deckled-card flex flex-col justify-between space-y-4 hover:border-purple-500/50 hover-lift shadow-lg">
                            <div class="space-y-4">
                                <div class="h-56 w-full overflow-hidden rounded-2xl bg-journalSurfaceSoft border border-journalBorder relative">
                                    <img src="<%= idol.image || 'https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&q=80&w=800' %>" 
                                         alt="<%= idol.name %>" 
                                         class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                                         onerror="this.src='https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&q=80&w=800'">
                                </div>
                                <div class="space-y-2">
                                    <h3 class="font-display font-bold text-xl text-journalText leading-tight"><%= idol.name %></h3>
                                    <blockquote class="font-reading text-sm text-journalMuted italic border-l-2 border-purple-500/60 pl-3 leading-relaxed">
                                        "<%= idol.quote %>"
                                    </blockquote>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </section>
        <% } %>

        <!-- Core Curated Inspirations (Original Heroes Restyled) -->
        <section class="space-y-8">
            <div class="flex items-center gap-2 pb-2 border-b border-journalBorder">
                <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
                <h2 class="font-display text-xl font-bold text-journalText m-0">Curated Thinkers & Innovators</h2>
                <span class="text-xs font-mono text-journalMuted uppercase tracking-wider">(Foundational Influences)</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Osho -->
                <article class="deckled-card grid grid-cols-1 md:grid-cols-5 gap-6 hover:border-purple-500/50 hover-lift shadow-xl">
                    <div class="md:col-span-2 h-48 md:h-full w-full overflow-hidden rounded-2xl border border-journalBorder">
                        <img src="https://e1.pxfuel.com/desktop-wallpaper/527/759/desktop-wallpaper-osho-osho-rajneesh-indian-thinker-indian-thinker-osho-rajneesh-osho.jpg" 
                             alt="Osho" 
                             class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
                    </div>
                    <div class="md:col-span-3 flex flex-col justify-between space-y-4 py-1">
                        <div class="space-y-2.5">
                            <span class="inline-block text-[10px] font-mono font-semibold bg-purple-500/10 text-purple-600 dark:text-purple-400 px-2.5 py-0.5 rounded-md border border-purple-500/20">SPIRITUAL PHILOSOPHER</span>
                            <h3 class="font-display font-bold text-xl text-journalText m-0">Osho</h3>
                            <blockquote class="font-reading text-xs text-journalMuted italic border-l-2 border-purple-500/60 pl-3 leading-relaxed">
                                "Don't be afraid of difficulties. The greater the difficulties, the more energy you will have to transform them into nourishment"
                            </blockquote>
                        </div>
                        <p class="text-xs font-body text-journalMuted leading-relaxed">
                            A primary source of inner calm. Listening to Osho provides clarity on living authentically and finding resilience during complex cycles.
                        </p>
                    </div>
                </article>

                <!-- Ratan Tata -->
                <article class="deckled-card grid grid-cols-1 md:grid-cols-5 gap-6 hover:border-blue-500/50 hover-lift shadow-xl">
                    <div class="md:col-span-2 h-48 md:h-full w-full overflow-hidden rounded-2xl border border-journalBorder">
                        <img src="https://www.tatatrusts.org/images/Ratan_N_Tata_sm.jpg" 
                             alt="Ratan Tata" 
                             class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
                    </div>
                    <div class="md:col-span-3 flex flex-col justify-between space-y-4 py-1">
                        <div class="space-y-2.5">
                            <span class="inline-block text-[10px] font-mono font-semibold bg-blue-500/10 text-blue-600 dark:text-blue-400 px-2.5 py-0.5 rounded-md border border-blue-500/20">INDUSTRIALIST & PHILANTHROPIST</span>
                            <h3 class="font-display font-bold text-xl text-journalText m-0">Ratan Tata</h3>
                            <blockquote class="font-reading text-xs text-journalMuted italic border-l-2 border-blue-500/60 pl-3 leading-relaxed">
                                "None can destroy iron, but its own rust can. Likewise, none can destroy a person, but his own mindset can."
                            </blockquote>
                        </div>
                        <p class="text-xs font-body text-journalMuted leading-relaxed">
                            Deeply inspiring for his profound kindness and humility, demonstrating that massive corporate scale can coexist with deep human service.
                        </p>
                    </div>
                </article>

                <!-- Bill Gates -->
                <article class="deckled-card grid grid-cols-1 md:grid-cols-5 gap-6 hover:border-emerald-500/50 hover-lift shadow-xl">
                    <div class="md:col-span-2 h-48 md:h-full w-full overflow-hidden rounded-2xl border border-journalBorder">
                        <img src="https://imageio.forbes.com/specials-images/imageserve/63a10cda05f6db21230c44d1/Bill-Gates/1960x0.jpg?format=jpg&width=1440" 
                             alt="Bill Gates" 
                             class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
                    </div>
                    <div class="md:col-span-3 flex flex-col justify-between space-y-4 py-1">
                        <div class="space-y-2.5">
                            <span class="inline-block text-[10px] font-mono font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-2.5 py-0.5 rounded-md border border-emerald-500/20">TECH PIONEER & VISIONARY</span>
                            <h3 class="font-display font-bold text-xl text-journalText m-0">Bill Gates</h3>
                            <blockquote class="font-reading text-xs text-journalMuted italic border-l-2 border-emerald-500/60 pl-3 leading-relaxed">
                                "Your most unhappy customers are your greatest source of learning."
                            </blockquote>
                        </div>
                        <p class="text-xs font-body text-journalMuted leading-relaxed">
                            Valued for his unparalleled technical focus during the microcomputer revolution and his subsequent commitment to global philanthropy.
                        </p>
                    </div>
                </article>

                <!-- Mark Zuckerberg -->
                <article class="deckled-card grid grid-cols-1 md:grid-cols-5 gap-6 hover:border-cyan-500/50 hover-lift shadow-xl">
                    <div class="md:col-span-2 h-48 md:h-full w-full overflow-hidden rounded-2xl border border-journalBorder">
                        <img src="https://www.telegraph.co.uk/multimedia/archive/02223/zckerberg_2223405b.jpg?imwidth=960" 
                             alt="Mark Zuckerberg" 
                             class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
                    </div>
                    <div class="md:col-span-3 flex flex-col justify-between space-y-4 py-1">
                        <div class="space-y-2.5">
                            <span class="inline-block text-[10px] font-mono font-semibold bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 px-2.5 py-0.5 rounded-md border border-cyan-500/20">NETWORKING PIONEER</span>
                            <h3 class="font-display font-bold text-xl text-journalText m-0">Mark Zuckerberg</h3>
                            <blockquote class="font-reading text-xs text-journalMuted italic border-l-2 border-cyan-500/60 pl-3 leading-relaxed">
                                "The biggest risk is not taking any risk. In a world that's changing really quickly, the only strategy that is guaranteed to fail is not taking risks."
                            </blockquote>
                        </div>
                        <p class="text-xs font-body text-journalMuted leading-relaxed">
                            An inspiration for his constant thirst to learn, adapt, and build next-generation connection protocols at speed.
                        </p>
                    </div>
                </article>
            </div>
        </section>

    </main>

    <%- include('partials/footer') %>

</body>
</html>

