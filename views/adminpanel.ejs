<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<%- include('partials/head', { title: "Neer's Journal - Enterprise Admin Control Center" }) %>
<body class="bg-journalBg text-journalText font-body antialiased selection:bg-indigo-500/30 selection:text-journalText page-fade-in min-h-screen flex flex-col justify-between">

    <%- include('partials/nav') %>

    <!-- Pass backend user context to client -->
    <script>
        window.currentUser = <%- JSON.stringify(currentUser) %>;
        window.allPermissions = <%- JSON.stringify(allPermissions) %>;
    </script>

    <style>
        .icon-selector {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(44px, 1fr));
            gap: 8px;
            margin-top: 10px;
            max-height: 180px;
            overflow-y: auto;
            padding: 10px;
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            background: var(--color-surface-soft);
        }
        .icon-option {
            font-size: 1.1rem;
            text-align: center;
            padding: 8px;
            cursor: pointer;
            border-radius: var(--radius-md);
            transition: all var(--transition-fast);
            color: var(--color-text-muted);
            border: 1px solid transparent;
        }
        .icon-option:hover {
            background: rgba(99, 102, 241, 0.15);
            color: #6366f1;
            border-color: rgba(99, 102, 241, 0.3);
            transform: scale(1.05);
        }
        .icon-option.selected {
            background: #6366f1;
            color: white;
            border-color: #6366f1;
        }
        .item-group {
            background: var(--color-surface-soft);
            padding: var(--space-5);
            border-radius: var(--radius-2xl);
            margin-bottom: var(--space-5);
            border: 1px solid var(--color-border);
            position: relative;
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
        }
        .form-group {
            margin-bottom: var(--space-4);
        }
        .nav-tab-btn {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 1.2rem;
            border-radius: 0.75rem;
            font-size: 0.75rem;
            font-family: var(--font-mono, monospace);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
            transition: all 0.2s ease;
            cursor: pointer;
            border: 1px solid transparent;
        }
        .nav-tab-btn.active {
            background: #6366f1;
            color: #ffffff;
            border-color: #6366f1;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }
        .nav-tab-btn:not(.active) {
            background: var(--color-surface-soft);
            color: var(--color-text-muted);
            border-color: var(--color-border);
        }
        .nav-tab-btn:not(.active):hover {
            border-color: #6366f1;
            color: #6366f1;
        }
        .badge-role {
            padding: 0.2rem 0.6rem;
            border-radius: 9999px;
            font-size: 0.65rem;
            font-family: var(--font-mono, monospace);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border: 1px solid transparent;
        }
        .role-SuperAdmin { background: rgba(139, 92, 246, 0.15); color: #8b5cf6; border-color: rgba(139, 92, 246, 0.3); }
        .role-Admin { background: rgba(99, 102, 241, 0.15); color: #6366f1; border-color: rgba(99, 102, 241, 0.3); }
        .role-Editor { background: rgba(16, 185, 129, 0.15); color: #10b981; border-color: rgba(16, 185, 129, 0.3); }
        .role-Moderator { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border-color: rgba(245, 158, 11, 0.3); }
        .role-ContentManager { background: rgba(14, 165, 233, 0.15); color: #0ea5e9; border-color: rgba(14, 165, 233, 0.3); }
        .role-Support { background: rgba(6, 182, 212, 0.15); color: #06b6d4; border-color: rgba(6, 182, 212, 0.3); }
        .role-Analytics { background: rgba(244, 63, 94, 0.15); color: #f43f5e; border-color: rgba(244, 63, 94, 0.3); }
        .role-ReadOnly { background: rgba(100, 116, 139, 0.15); color: #64748b; border-color: rgba(100, 116, 139, 0.3); }
        .role-User { background: rgba(107, 114, 128, 0.15); color: #6b7280; border-color: rgba(107, 114, 128, 0.3); }
        .role-Visitor { background: rgba(59, 130, 246, 0.15); color: #3b82f6; border-color: rgba(59, 130, 246, 0.3); }
        
        .toast-container {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .toast {
            min-width: 280px;
            padding: 12px 18px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-family: var(--font-mono, monospace);
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.2);
            animation: slideInRight 0.3s ease;
        }
        @keyframes slideInRight {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
    </style>

    <div class="toast-container" id="toastContainer"></div>

    <main class="max-w-7xl mx-auto px-4 md:px-8 py-10 space-y-8 flex-1 w-full">

        <!-- Header Profile Banner -->
        <div class="glass-panel rounded-3xl p-6 md:p-8 border border-journalBorder flex flex-col md:flex-row md:items-center justify-between gap-6 shadow-xl">
            <div class="space-y-2">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 text-xs font-mono">
                    <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
                    ENTERPRISE SECURITY & AUTHORIZATION FRAMEWORK
                </div>
                <h1 class="font-display text-3xl md:text-4xl font-extrabold text-journalText flex items-center gap-3 m-0">
                    <i class="fas fa-shield-alt text-indigo-500"></i> Admin Control Center
                </h1>
                <p class="text-xs font-mono text-journalMuted uppercase tracking-wider">
                    AUTHENTICATED AS: <span class="text-journalText font-bold"><%= currentUser.username %></span> (<%= currentUser.email %>)
                </p>
            </div>

            <div class="flex items-center gap-3 flex-wrap">
                <span class="badge-role role-<%= currentUser.role %>">
                    <i class="fas fa-user-shield mr-1"></i> <%= currentUser.role %>
                </span>
                <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-mono uppercase font-bold">
                    STATUS: <%= currentUser.status %>
                </span>
                <a href="/logout" class="bg-red-500/10 hover:bg-red-500/20 text-red-600 dark:text-red-400 border border-red-500/20 px-4 py-2 rounded-xl text-xs font-mono uppercase tracking-wider font-semibold transition-all">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-journalBorder no-scrollbar">
            <button class="nav-tab-btn active" onclick="switchTab('editorialTab')" id="btn-editorialTab">
                <i class="fas fa-pen-fancy"></i> Editorial Modules
            </button>
            <button class="nav-tab-btn" onclick="switchTab('usersTab')" id="btn-usersTab">
                <i class="fas fa-users-cog"></i> Users & Approvals
            </button>
            <button class="nav-tab-btn" onclick="switchTab('rolesTab')" id="btn-rolesTab">
                <i class="fas fa-key"></i> Permission Matrix
            </button>
            <button class="nav-tab-btn" onclick="switchTab('sessionsTab')" id="btn-sessionsTab">
                <i class="fas fa-desktop"></i> Active Sessions
            </button>
            <button class="nav-tab-btn" onclick="switchTab('auditTab')" id="btn-auditTab">
                <i class="fas fa-history"></i> Audit Trail
            </button>
            <button class="nav-tab-btn" onclick="switchTab('analyticsTab')" id="btn-analyticsTab">
                <i class="fas fa-chart-bar"></i> Security Analytics
            </button>
        </div>

        <!-- ==================== TAB 1: EDITORIAL MODULES ==================== -->
        <div id="editorialTab" class="tab-content space-y-8">
            
            <!-- Learning Skills Section -->
            <section class="glass-panel rounded-3xl p-6 md:p-8 space-y-6 shadow-xl" id="skillsSection">
                <div class="border-b border-journalBorder pb-4 flex flex-col md:flex-row md:items-center justify-between gap-2">
                    <div>
                        <h2 class="font-display text-2xl font-bold flex items-center gap-3 text-journalText m-0">
                            <i class="fas fa-brain text-indigo-500"></i> Learning Skills
                        </h2>
                        <p class="text-[10px] font-mono text-journalMuted uppercase tracking-wider mt-1">MANAGE CORE CAPABILITIES AND PROGRESS METRICS</p>
                    </div>
                    <span class="text-xs font-mono bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 px-3 py-1 rounded-full border border-indigo-500/20">Skill Nodes</span>
                </div>
                
                <form id="learningForm" class="space-y-4">
                    <div id="skillsContainer" class="space-y-4"></div>
                    <div class="flex flex-col md:flex-row gap-4 pt-4 edit-control">
                        <button type="button" onclick="addSkill()" class="bg-journalSurface border border-journalBorder hover:border-indigo-500 hover:text-indigo-500 text-journalText py-2.5 px-5 rounded-xl text-xs font-mono uppercase tracking-wider font-semibold transition-all flex items-center justify-center gap-2">
                            <i class="fas fa-plus"></i> Add Skill Node
                        </button>
                        <button type="submit" class="flex-1 btn-primary py-2.5 px-6 rounded-xl text-xs font-mono uppercase tracking-wider font-semibold shadow-md">
                            Save Learning Skills
                        </button>
                    </div>
                </form>
            </section>

            <!-- Projects Section -->
            <section class="glass-panel rounded-3xl p-6 md:p-8 space-y-6 shadow-xl" id="projectsSection">
                <div class="border-b border-journalBorder pb-4 flex flex-col md:flex-row md:items-center justify-between gap-2">
                    <div>
                        <h2 class="font-display text-2xl font-bold flex items-center gap-3 text-journalText m-0">
                            <i class="fas fa-laptop-code text-indigo-500"></i> Working Projects
                        </h2>
                        <p class="text-[10px] font-mono text-journalMuted uppercase tracking-wider mt-1">CURATE ACTIVE DEVELOPMENT LABS AND TIMELINES</p>
                    </div>
                    <span class="text-xs font-mono bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 px-3 py-1 rounded-full border border-indigo-500/20">Project Labs</span>
                </div>

                <form id="workingForm" class="space-y-4">
                    <div id="projectsContainer" class="space-y-4"></div>
                    <div class="flex flex-col md:flex-row gap-4 pt-4 edit-control">
                        <button type="button" onclick="addProject()" class="bg-journalSurface border border-journalBorder hover:border-indigo-500 hover:text-indigo-500 text-journalText py-2.5 px-5 rounded-xl text-xs font-mono uppercase tracking-wider font-semibold transition-all flex items-center justify-center gap-2">
                            <i class="fas fa-plus"></i> Add Project Node
                        </button>
                        <button type="submit" class="flex-1 btn-primary py-2.5 px-6 rounded-xl text-xs font-mono uppercase tracking-wider font-semibold shadow-md">
                            Save Working Projects
                        </button>
                    </div>
                </form>
            </section>

            <!-- Deadlines & Study Focus -->
            <section class="glass-panel rounded-3xl p-6 md:p-8 space-y-6 shadow-xl">
                <div class="border-b border-journalBorder pb-4">
                    <h2 class="font-display text-2xl font-bold flex items-center gap-3 text-journalText m-0">
                        <i class="fas fa-calendar-alt text-indigo-500"></i> Study Focus & Milestones
                    </h2>
                    <p class="text-[10px] font-mono text-journalMuted uppercase tracking-wider mt-1">SYNC DAILY CURRICULUMS AND ACADEMIC MILESTONES</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- Study Focus Form -->
                    <div class="space-y-4 bg-journalSurfaceSoft p-5 rounded-2xl border border-journalBorder shadow-inner">
                        <h3 class="font-display text-lg font-bold text-journalText flex items-center gap-2 m-0">
                            <i class="fas fa-book-reader text-indigo-500"></i> Topic Trackers
                        </h3>
                        <form id="studyForm" class="space-y-4">
                            <div id="studyContainer" class="space-y-3"></div>
                            <div class="flex flex-col gap-2 pt-2 edit-control">
                                <button type="button" onclick="addStudy()" class="bg-journalSurface border border-journalBorder hover:border-indigo-500 text-journalText py-2 px-4 rounded-xl text-[10px] font-mono uppercase font-semibold">
                                    + Add Topic Node
                                </button>
                                <button type="submit" class="btn-primary py-2 px-4 rounded-xl text-[10px] font-mono uppercase font-semibold">
                                    Save Study Focus
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Deadlines Form -->
                    <div class="space-y-4 bg-journalSurfaceSoft p-5 rounded-2xl border border-journalBorder shadow-inner">
                        <h3 class="font-display text-lg font-bold text-journalText flex items-center gap-2 m-0">
                            <i class="fas fa-hourglass-half text-purple-500"></i> Upcoming Deadlines
                        </h3>
                        <form id="deadlineForm" class="space-y-4">
                            <div id="deadlineContainer" class="space-y-3"></div>
                            <div class="flex flex-col gap-2 pt-2 edit-control">
                                <button type="button" onclick="addDeadline()" class="bg-journalSurface border border-journalBorder hover:border-purple-500 text-journalText py-2 px-4 rounded-xl text-[10px] font-mono uppercase font-semibold">
                                    + Add Milestone Node
                                </button>
                                <button type="submit" class="btn-primary py-2 px-4 rounded-xl text-[10px] font-mono uppercase font-semibold">
                                    Save Deadlines
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </section>

            <!-- Activity Focus Section -->
            <section class="glass-panel rounded-3xl p-6 md:p-8 space-y-6 shadow-xl">
                <div class="border-b border-journalBorder pb-4">
                    <h2 class="font-display text-2xl font-bold flex items-center gap-3 text-journalText m-0">
                        <i class="fas fa-running text-indigo-500"></i> Current Activity Focus
                    </h2>
                    <p class="text-[10px] font-mono text-journalMuted uppercase tracking-wider mt-1">BIO OVERVIEW TEXT</p>
                </div>

                <form id="activityForm" class="space-y-4">
                    <div class="space-y-1.5">
                        <label for="activityText" class="text-xs font-mono font-bold uppercase tracking-wider text-journalText">Active Activity Description</label>
                        <textarea id="activityText" name="text" placeholder="e.g. Architecting enterprise authorization matrix..." required
                                  class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-3 focus:outline-none focus:border-indigo-500 text-journalText placeholder:text-journalMuted transition-colors shadow-inner h-28"></textarea>
                    </div>
                    <button type="submit" class="w-full btn-primary py-3.5 rounded-xl text-xs font-mono uppercase tracking-wider font-semibold shadow-md edit-control">
                        Update Current Activity Status
                    </button>
                </form>
            </section>
        </div>

        <!-- ==================== TAB 2: USERS & APPROVALS ==================== -->
        <div id="usersTab" class="tab-content space-y-8 hidden">
            
            <!-- Chronicle Reader Invitation Requests Section -->
            <section class="glass-panel rounded-3xl p-6 md:p-8 space-y-6 shadow-xl border-l-4 border-l-journalAccent">
                <div class="border-b border-journalBorder pb-4 flex items-center justify-between">
                    <div>
                        <h2 class="font-display text-xl font-bold flex items-center gap-3 text-journalText m-0">
                            <i class="fas fa-envelope-open-text text-journalAccent"></i> Chronicle Invitation Requests
                        </h2>
                        <p class="text-[10px] font-mono text-journalMuted uppercase tracking-wider mt-1">APPLICANTS SEEKING AUTHORIZED CHRONICLE READER ACCESS</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <select id="invitationStatusFilter" onchange="loadInvitationRequests()" class="text-xs font-mono bg-journalSurface border border-journalBorder rounded-xl px-3 py-1.5">
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Archived">Archived</option>
                            <option value="ALL">All Requests</option>
                        </select>
                        <button onclick="loadInvitationRequests()" class="text-xs font-mono text-journalAccent hover:underline"><i class="fas fa-sync"></i> Refresh</button>
                    </div>
                </div>

                <div id="invitationRequestsContainer" class="space-y-4">
                    <p class="text-xs font-mono text-journalMuted italic">Loading chronicle invitation requests...</p>
                </div>
            </section>

            <!-- Pending Admin Access Requests -->
            <section class="glass-panel rounded-3xl p-6 md:p-8 space-y-6 shadow-xl border-l-4 border-l-amber-500">
                <div class="border-b border-journalBorder pb-4 flex items-center justify-between">
                    <div>
                        <h2 class="font-display text-xl font-bold flex items-center gap-3 text-journalText m-0">
                            <i class="fas fa-user-clock text-amber-500"></i> Pending Admin Access Requests
                        </h2>
                        <p class="text-[10px] font-mono text-journalMuted uppercase tracking-wider mt-1">APPROVAL WORKFLOW FOR NEW ADMINISTRATIVE APPLICANTS</p>
                    </div>
                    <button onclick="loadPendingRequests()" class="text-xs font-mono text-indigo-500 hover:underline"><i class="fas fa-sync"></i> Refresh</button>
                </div>

                <div id="pendingRequestsContainer" class="space-y-4">
                    <p class="text-xs font-mono text-journalMuted italic">Loading pending requests...</p>
                </div>
            </section>

            <!-- User Directory & Management -->
            <section class="glass-panel rounded-3xl p-6 md:p-8 space-y-6 shadow-xl">
                <div class="border-b border-journalBorder pb-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h2 class="font-display text-2xl font-bold flex items-center gap-3 text-journalText m-0">
                            <i class="fas fa-users text-indigo-500"></i> User Directory & Access Control
                        </h2>
                        <p class="text-[10px] font-mono text-journalMuted uppercase tracking-wider mt-1">VIEW, SUSPEND, RE-ENABLE, OR ASSIGN ROLES TO ALL USERS</p>
                    </div>
                    <input type="text" id="userSearchInput" onkeyup="filterUsers()" placeholder="Search user by name or email..." 
                           class="text-xs font-mono bg-journalSurface border border-journalBorder rounded-xl px-4 py-2 w-full md:w-64 focus:outline-none focus:border-indigo-500" />
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs font-mono border-collapse">
                        <thead>
                            <tr class="border-b border-journalBorder text-journalMuted uppercase">
                                <th class="p-3">User</th>
                                <th class="p-3">Role</th>
                                <th class="p-3">Status</th>
                                <th class="p-3">Last Activity</th>
                                <th class="p-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="usersTableBody">
                            <tr><td colspan="5" class="p-4 text-center italic text-journalMuted">Loading users...</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <!-- ==================== TAB 3: PERMISSION MATRIX ==================== -->
        <div id="rolesTab" class="tab-content space-y-8 hidden">
            <section class="glass-panel rounded-3xl p-6 md:p-8 space-y-6 shadow-xl">
                <div class="border-b border-journalBorder pb-4">
                    <h2 class="font-display text-2xl font-bold flex items-center gap-3 text-journalText m-0">
                        <i class="fas fa-key text-indigo-500"></i> Role Based Permission Matrix
                    </h2>
                    <p class="text-[10px] font-mono text-journalMuted uppercase tracking-wider mt-1">OVERVIEW OF ALL ENTERPRISE PERMISSIONS MAPPED TO SYSTEM ROLES</p>
                </div>

                <div id="permissionMatrixContainer" class="overflow-x-auto">
                    <p class="text-xs font-mono text-journalMuted italic">Loading permission matrix...</p>
                </div>
            </section>
        </div>

        <!-- ==================== TAB 4: ACTIVE SESSIONS ==================== -->
        <div id="sessionsTab" class="tab-content space-y-8 hidden">
            <section class="glass-panel rounded-3xl p-6 md:p-8 space-y-6 shadow-xl">
                <div class="border-b border-journalBorder pb-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h2 class="font-display text-2xl font-bold flex items-center gap-3 text-journalText m-0">
                            <i class="fas fa-desktop text-indigo-500"></i> Active Session Management
                        </h2>
                        <p class="text-[10px] font-mono text-journalMuted uppercase tracking-wider mt-1">TERMINATE UNRECOGNIZED BROWSER SESSIONS</p>
                    </div>
                    <button onclick="terminateAllOtherSessions()" class="bg-red-500/10 hover:bg-red-500/20 text-red-600 dark:text-red-400 border border-red-500/20 px-4 py-2 rounded-xl text-xs font-mono uppercase font-bold">
                        <i class="fas fa-power-off"></i> Terminate All Other Sessions
                    </button>
                </div>

                <div id="sessionsContainer" class="space-y-4">
                    <p class="text-xs font-mono text-journalMuted italic">Loading active sessions...</p>
                </div>
            </section>
        </div>

        <!-- ==================== TAB 5: AUDIT TRAIL ==================== -->
        <div id="auditTab" class="tab-content space-y-8 hidden">
            <section class="glass-panel rounded-3xl p-6 md:p-8 space-y-6 shadow-xl">
                <div class="border-b border-journalBorder pb-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h2 class="font-display text-2xl font-bold flex items-center gap-3 text-journalText m-0">
                            <i class="fas fa-history text-indigo-500"></i> Audit Trail & Activity Logs
                        </h2>
                        <p class="text-[10px] font-mono text-journalMuted uppercase tracking-wider mt-1">IMMUTABLE SECURITY REGISTRY OF ALL ADMINISTRATIVE ACTIONS</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="text" id="auditSearchInput" onkeyup="loadAuditLogs()" placeholder="Search action, admin, target..." 
                               class="text-xs font-mono bg-journalSurface border border-journalBorder rounded-xl px-3 py-1.5 focus:outline-none focus:border-indigo-500" />
                        <select id="auditResultFilter" onchange="loadAuditLogs()" class="text-xs font-mono bg-journalSurface border border-journalBorder rounded-xl px-3 py-1.5">
                            <option value="ALL">All Results</option>
                            <option value="SUCCESS">SUCCESS</option>
                            <option value="FAILURE">FAILURE</option>
                            <option value="BLOCKED">BLOCKED</option>
                        </select>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs font-mono border-collapse">
                        <thead>
                            <tr class="border-b border-journalBorder text-journalMuted uppercase">
                                <th class="p-3">Timestamp</th>
                                <th class="p-3">Admin</th>
                                <th class="p-3">Action</th>
                                <th class="p-3">Target</th>
                                <th class="p-3">Result</th>
                                <th class="p-3">IP / Device</th>
                            </tr>
                        </thead>
                        <tbody id="auditTableBody">
                            <tr><td colspan="6" class="p-4 text-center italic text-journalMuted">Loading audit logs...</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <!-- ==================== TAB 6: SECURITY ANALYTICS ==================== -->
        <div id="analyticsTab" class="tab-content space-y-8 hidden">
            <section class="glass-panel rounded-3xl p-6 md:p-8 space-y-6 shadow-xl">
                <div class="border-b border-journalBorder pb-4">
                    <h2 class="font-display text-2xl font-bold flex items-center gap-3 text-journalText m-0">
                        <i class="fas fa-chart-bar text-indigo-500"></i> Security & Activity Analytics
                    </h2>
                    <p class="text-[10px] font-mono text-journalMuted uppercase tracking-wider mt-1">REAL-TIME TELEMETRY AND SECURITY ALERTS</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="analyticsMetricsGrid">
                    <div class="bg-journalSurfaceSoft p-5 rounded-2xl border border-journalBorder space-y-2">
                        <p class="text-[10px] font-mono uppercase text-journalMuted">Total Users</p>
                        <h3 class="text-2xl font-bold text-journalText" id="metricTotalUsers">-</h3>
                    </div>
                    <div class="bg-journalSurfaceSoft p-5 rounded-2xl border border-journalBorder space-y-2">
                        <p class="text-[10px] font-mono uppercase text-journalMuted">Active Admins</p>
                        <h3 class="text-2xl font-bold text-indigo-500" id="metricActiveAdmins">-</h3>
                    </div>
                    <div class="bg-journalSurfaceSoft p-5 rounded-2xl border border-journalBorder space-y-2">
                        <p class="text-[10px] font-mono uppercase text-journalMuted">Pending Approvals</p>
                        <h3 class="text-2xl font-bold text-amber-500" id="metricPendingRequests">-</h3>
                    </div>
                    <div class="bg-journalSurfaceSoft p-5 rounded-2xl border border-journalBorder space-y-2">
                        <p class="text-[10px] font-mono uppercase text-journalMuted">Failed Login Events</p>
                        <h3 class="text-2xl font-bold text-red-500" id="metricFailedLogins">-</h3>
                    </div>
                </div>
            </section>
        </div>

    </main>

    <%- include('partials/footer') %>

    <script>
        // Toast helper
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            const bgColor = type === 'success' ? 'bg-emerald-600 text-white' : (type === 'error' ? 'bg-red-600 text-white' : 'bg-indigo-600 text-white');
            toast.className = `toast ${bgColor}`;
            toast.innerHTML = `<div class="flex items-center gap-2"><i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-info-circle'}"></i> <span>${message}</span></div>`;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        }

        // Tab Switching Logic
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-tab-btn').forEach(el => el.classList.remove('active'));
            
            const target = document.getElementById(tabId);
            const btn = document.getElementById(`btn-${tabId}`);
            if (target && btn) {
                target.classList.remove('hidden');
                btn.classList.add('active');
            }

            if (tabId === 'usersTab') {
                loadUsersDirectory();
                loadPendingRequests();
                loadInvitationRequests();
            } else if (tabId === 'rolesTab') {
                loadPermissionMatrix();
            } else if (tabId === 'sessionsTab') {
                loadActiveSessions();
            } else if (tabId === 'auditTab') {
                loadAuditLogs();
            } else if (tabId === 'analyticsTab') {
                loadAnalytics();
            }
        }

        // Icon Selector
        const icons = [
            'fa-brain','fa-laptop-code','fa-globe-americas','fa-cogs','fa-calendar-alt','fa-folder-open',
            'fa-python','fa-video','fa-camera','fa-book-open','fa-robot','fa-mobile-alt','fa-chart-line',
            'fa-code','fa-bug','fa-lightbulb','fa-sitemap','fa-network-wired','fa-palette','fa-star'
        ];

        const createIconSelector = (name, selected = '') => {
            const div = document.createElement('div');
            div.className = 'icon-selector';
            icons.forEach(icon => {
                const span = document.createElement('span');
                span.className = `icon-option ${icon === selected ? 'selected' : ''}`;
                span.innerHTML = `<i class="fas ${icon}"></i>`;
                span.onclick = () => {
                    div.querySelectorAll('.icon-option').forEach(s => s.classList.remove('selected'));
                    span.classList.add('selected');
                    div.previousElementSibling.value = icon;
                };
                div.appendChild(span);
            });
            return div;
        };

        // Load Editorial Data
        const loadEditorialData = async (key, containerId, templateFn) => {
            try {
                const res = await fetch(`/api/admin/${key}`);
                if (!res.ok) return;
                const data = await res.json();
                const container = document.getElementById(containerId);
                container.innerHTML = '';
                (data || []).forEach((item, i) => {
                    container.appendChild(templateFn(item, i));
                });
            } catch (err) { console.error(err); }
        };

        // Save Editorial Data
        const saveEditorialData = async (formId, endpoint, successMsg) => {
            const form = document.getElementById(formId);
            if (!form) return;
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const data = {};
                if (formId === 'learningForm') data.skills = collectItems('skill');
                if (formId === 'workingForm') data.projects = collectItems('project');
                if (formId === 'studyForm') data.study = collectItems('study');
                if (formId === 'deadlineForm') data.deadlines = collectItems('deadline');
                if (formId === 'activityForm') data.text = document.getElementById('activityText').value;

                try {
                    const res = await fetch(`/api/admin/${endpoint}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await res.json();
                    if (res.ok) {
                        showToast(result.success || successMsg, 'success');
                    } else {
                        showToast(result.error || 'Failed to save', 'error');
                    }
                } catch (err) { showToast('Network error while saving data', 'error'); }
            });
        };

        const collectItems = (prefix) => {
            const items = [];
            document.querySelectorAll(`.item-group[data-type="${prefix}"]`).forEach(el => {
                const obj = {};
                if (el.dataset.id) obj._id = el.dataset.id;
                el.querySelectorAll('input, textarea, select').forEach(input => {
                    const fieldName = input.name.split('_')[2] || input.name;
                    obj[fieldName] = input.value;
                });
                items.push(obj);
            });
            return items;
        };

        // Skill Template
        const skillTemplate = (skill = {}, index) => {
            const div = document.createElement('div');
            div.className = 'item-group';
            div.dataset.type = 'skill';
            if (skill._id) div.dataset.id = skill._id;
            div.innerHTML = `
                <button type="button" class="absolute top-4 right-4 bg-red-500/10 text-red-600 text-xs py-1 px-3 rounded-full font-mono uppercase font-semibold edit-control" onclick="this.parentElement.remove()">Remove</button>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="text-[10px] font-mono font-bold uppercase text-journalText">Skill Name</label>
                        <input type="text" name="skill_${index}_name" value="${skill.name || ''}" placeholder="e.g. Python" required 
                               class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-2.5 text-journalText" />
                    </div>
                    <div class="form-group">
                        <label class="text-[10px] font-mono font-bold uppercase text-journalText">Progress (%)</label>
                        <input type="number" name="skill_${index}_progress" min="0" max="100" value="${skill.progress || 0}" required 
                               class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-2.5 text-journalText" />
                    </div>
                </div>
                <div class="form-group mt-3">
                    <label class="text-[10px] font-mono font-bold uppercase text-journalText">Description</label>
                    <textarea name="skill_${index}_desc" required
                              class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-2.5 text-journalText h-20">${skill.desc || ''}</textarea>
                </div>
                <div class="form-group mt-3">
                    <label class="text-[10px] font-mono font-bold uppercase text-journalText">Icon Class</label>
                    <input type="text" name="skill_${index}_icon" value="${skill.icon || 'fa-brain'}" readonly 
                           class="w-full text-xs font-mono bg-journalSurfaceSoft border border-journalBorder rounded-xl px-4 py-2 text-journalText mb-2" />
                </div>
            `;
            div.querySelector('input[readonly]').after(createIconSelector(`skill_${index}_icon`, skill.icon));
            return div;
        };

        const addSkill = () => {
            const container = document.getElementById('skillsContainer');
            container.appendChild(skillTemplate({}, container.children.length));
        };

        // Project Template
        const projectTemplate = (proj = {}, index) => {
            const div = document.createElement('div');
            div.className = 'item-group';
            div.dataset.type = 'project';
            if (proj._id) div.dataset.id = proj._id;
            
            let formattedDate = proj.date ? new Date(proj.date).toISOString().split('T')[0] : '';
            div.innerHTML = `
                <button type="button" class="absolute top-4 right-4 bg-red-500/10 text-red-600 text-xs py-1 px-3 rounded-full font-mono uppercase font-semibold edit-control" onclick="this.parentElement.remove()">Remove</button>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="form-group md:col-span-2">
                        <label class="text-[10px] font-mono font-bold uppercase text-journalText">Project Title</label>
                        <input type="text" name="project_${index}_title" value="${proj.title || ''}" required 
                               class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-2.5 text-journalText" />
                    </div>
                    <div class="form-group">
                        <label class="text-[10px] font-mono font-bold uppercase text-journalText">Progress (%)</label>
                        <input type="number" name="project_${index}_progress" min="0" max="100" value="${proj.progress || 0}" required 
                               class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-2.5 text-journalText" />
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-3">
                    <div class="form-group">
                        <label class="text-[10px] font-mono font-bold uppercase text-journalText">Target Date</label>
                        <input type="date" name="project_${index}_date" value="${formattedDate}" required 
                               class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-2.5 text-journalText" />
                    </div>
                </div>
                <div class="form-group mt-3">
                    <label class="text-[10px] font-mono font-bold uppercase text-journalText">Description</label>
                    <textarea name="project_${index}_desc" required
                              class="w-full text-sm font-body bg-journalSurface border border-journalBorder rounded-xl px-4 py-2.5 text-journalText h-20">${proj.desc || ''}</textarea>
                </div>
                <div class="form-group mt-3">
                    <label class="text-[10px] font-mono font-bold uppercase text-journalText">Icon Class</label>
                    <input type="text" name="project_${index}_icon" value="${proj.icon || 'fa-laptop-code'}" readonly 
                           class="w-full text-xs font-mono bg-journalSurfaceSoft border border-journalBorder rounded-xl px-4 py-2 text-journalText mb-2" />
                </div>
            `;
            div.querySelector('input[readonly]').after(createIconSelector(`project_${index}_icon`, proj.icon));
            return div;
        };

        const addProject = () => {
            const container = document.getElementById('projectsContainer');
            container.appendChild(projectTemplate({}, container.children.length));
        };

        const studyTemplate = (item = {}, index) => {
            const div = document.createElement('div');
            div.className = 'item-group';
            div.dataset.type = 'study';
            if (item._id) div.dataset.id = item._id;
            div.innerHTML = `
                <button type="button" class="absolute top-3 right-3 text-red-500 text-[9px] font-mono uppercase edit-control" onclick="this.parentElement.remove()">✕</button>
                <div class="form-group">
                    <label class="text-[9px] font-mono font-bold uppercase text-journalText">Topic Name</label>
                    <input type="text" name="study_${index}_topic" value="${item.topic || ''}" required 
                           class="w-full text-xs font-body bg-journalSurface border border-journalBorder rounded-xl px-3 py-2 text-journalText" />
                </div>
                <div class="form-group">
                    <label class="text-[9px] font-mono font-bold uppercase text-journalText">Status</label>
                    <select name="study_${index}_status" class="w-full text-xs font-body bg-journalSurface border border-journalBorder rounded-xl px-2 py-2 text-journalText">
                        <option ${item.status === 'In Progress' ? 'selected' : ''}>In Progress</option>
                        <option ${item.status === 'Starting Soon' ? 'selected' : ''}>Starting Soon</option>
                        <option ${item.status === 'Revisiting' ? 'selected' : ''}>Revisiting</option>
                        <option ${item.status === 'Ongoing Study' ? 'selected' : ''}>Ongoing Study</option>
                    </select>
                </div>
            `;
            return div;
        };

        const addStudy = () => {
            const container = document.getElementById('studyContainer');
            container.appendChild(studyTemplate({}, container.children.length));
        };

        const deadlineTemplate = (item = {}, index) => {
            const div = document.createElement('div');
            div.className = 'item-group';
            div.dataset.type = 'deadline';
            if (item._id) div.dataset.id = item._id;
            let formattedDate = item.date ? new Date(item.date).toISOString().split('T')[0] : '';
            div.innerHTML = `
                <button type="button" class="absolute top-3 right-3 text-red-500 text-[9px] font-mono uppercase edit-control" onclick="this.parentElement.remove()">✕</button>
                <div class="form-group">
                    <label class="text-[9px] font-mono font-bold uppercase text-journalText">Milestone Task</label>
                    <input type="text" name="deadline_${index}_task" value="${item.task || ''}" required 
                           class="w-full text-xs font-body bg-journalSurface border border-journalBorder rounded-xl px-3 py-2 text-journalText" />
                </div>
                <div class="form-group">
                    <label class="text-[9px] font-mono font-bold uppercase text-journalText">Date Limit</label>
                    <input type="date" name="deadline_${index}_date" value="${formattedDate}" required 
                           class="w-full text-xs font-body bg-journalSurface border border-journalBorder rounded-xl px-3 py-2 text-journalText" />
                </div>
            `;
            return div;
        };

        const addDeadline = () => {
            const container = document.getElementById('deadlineContainer');
            container.appendChild(deadlineTemplate({}, container.children.length));
        };

        // TAB 2: Users & Approvals Logic
        let cachedUsers = [];
        async function loadUsersDirectory() {
            try {
                const res = await fetch('/api/admin/users');
                if (!res.ok) return;
                cachedUsers = await res.json();
                renderUsersTable(cachedUsers);
            } catch (err) { console.error(err); }
        }

        function renderUsersTable(users) {
            const tbody = document.getElementById('usersTableBody');
            tbody.innerHTML = '';
            if (users.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center italic text-journalMuted">No users found.</td></tr>';
                return;
            }
            users.forEach(u => {
                const tr = document.createElement('tr');
                tr.className = 'border-b border-journalBorder/50 hover:bg-journalSurfaceSoft/50';
                tr.innerHTML = `
                    <td class="p-3 font-bold">${u.username} <div class="text-[10px] text-journalMuted font-normal">${u.email}</div></td>
                    <td class="p-3"><span class="badge-role role-${u.role || 'User'}">${u.role || 'User'}</span></td>
                    <td class="p-3"><span class="px-2 py-0.5 rounded-full text-[10px] uppercase font-bold ${u.status === 'Active' ? 'bg-emerald-500/10 text-emerald-500' : 'bg-red-500/10 text-red-500'}">${u.status || 'Active'}</span></td>
                    <td class="p-3 text-journalMuted text-[10px]">${u.updatedAt ? new Date(u.updatedAt).toLocaleDateString() : 'N/A'}</td>
                    <td class="p-3 text-right space-x-2">
                        ${u.status === 'Active' ? `<button onclick="changeUserStatus('${u._id}', 'Suspended')" class="text-amber-500 hover:underline">Suspend</button>` : `<button onclick="changeUserStatus('${u._id}', 'Active')" class="text-emerald-500 hover:underline">Activate</button>`}
                        <button onclick="promptResetPassword('${u._id}', '${u.username}')" class="text-indigo-500 hover:underline">Reset Pwd</button>
                        ${u.username !== 'neer_7007' ? `<button onclick="deleteUser('${u._id}', '${u.username}')" class="text-red-500 hover:underline">Delete</button>` : ''}
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filterUsers() {
            const query = document.getElementById('userSearchInput').value.toLowerCase();
            const filtered = cachedUsers.filter(u => u.username.toLowerCase().includes(query) || u.email.toLowerCase().includes(query));
            renderUsersTable(filtered);
        }

        async function changeUserStatus(userId, newStatus) {
            if (!confirm(`Confirm changing user status to ${newStatus}?`)) return;
            try {
                const res = await fetch(`/api/admin/users/${userId}/status`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: newStatus })
                });
                const data = await res.json();
                showToast(data.success || data.error, res.ok ? 'success' : 'error');
                loadUsersDirectory();
            } catch (err) { showToast('Error updating status', 'error'); }
        }

        async function promptResetPassword(userId, username) {
            const newPassword = prompt(`Enter new secure password for ${username}:`);
            if (!newPassword) return;
            try {
                const res = await fetch(`/api/admin/users/${userId}/reset-password`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ newPassword })
                });
                const data = await res.json();
                showToast(data.success || data.error, res.ok ? 'success' : 'error');
            } catch (err) { showToast('Error resetting password', 'error'); }
        }

        async function deleteUser(userId, username) {
            if (!confirm(`Are you sure you want to permanently delete user ${username}?`)) return;
            try {
                const res = await fetch(`/api/admin/users/${userId}`, { method: 'DELETE' });
                const data = await res.json();
                showToast(data.success || data.error, res.ok ? 'success' : 'error');
                loadUsersDirectory();
            } catch (err) { showToast('Error deleting user', 'error'); }
        }

        // Load Chronicle Reader Invitations
        async function loadInvitationRequests() {
            try {
                const statusFilter = document.getElementById('invitationStatusFilter')?.value || 'Pending';
                const res = await fetch(`/api/admin/invitations?status=${encodeURIComponent(statusFilter)}`);
                if (!res.ok) return;
                const invitations = await res.json();
                const container = document.getElementById('invitationRequestsContainer');
                container.innerHTML = '';

                if (!invitations || invitations.length === 0) {
                    container.innerHTML = `<p class="text-xs font-mono text-journalMuted italic">No invitation requests found with status "${statusFilter}".</p>`;
                    return;
                }

                invitations.forEach(inv => {
                    const card = document.createElement('div');
                    card.className = 'bg-journalSurfaceSoft p-5 rounded-2xl border border-journalBorder flex flex-col md:flex-row md:items-start justify-between gap-4 shadow-sm';
                    
                    let statusBadge = 'bg-amber-500/10 text-amber-500 border-amber-500/20';
                    if (inv.status === 'Approved') statusBadge = 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20';
                    if (inv.status === 'Rejected') statusBadge = 'bg-red-500/10 text-red-500 border-red-500/20';
                    if (inv.status === 'Archived') statusBadge = 'bg-slate-500/10 text-slate-400 border-slate-500/20';

                    card.innerHTML = `
                        <div class="space-y-2 flex-1">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="font-bold text-sm text-journalText">${inv.name}</span>
                                <span class="text-xs font-mono text-journalMuted">(${inv.email})</span>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase border ${statusBadge}">${inv.status}</span>
                            </div>
                            <div class="text-xs font-mono text-journalMuted flex items-center gap-4">
                                <span>Display Name: <strong class="text-journalText">${inv.preferredDisplayName || inv.name}</strong></span>
                                <span>Country: <strong class="text-journalText">${inv.country || 'N/A'}</strong></span>
                                <span>Requested: <strong class="text-journalText">${new Date(inv.createdAt).toLocaleString()}</strong></span>
                            </div>
                            <div class="text-xs font-reading text-journalMuted italic bg-journalSurface p-3 rounded-xl border border-journalBorder/60">
                                "${inv.reason}"
                            </div>
                            ${inv.status === 'Approved' ? `<div class="text-[11px] font-mono text-emerald-500">Approved as: <strong>${inv.assignedUsername}</strong> by ${inv.approvedByName || 'Admin'}</div>` : ''}
                        </div>

                        ${inv.status === 'Pending' ? `
                            <div class="flex flex-row md:flex-col items-center gap-2 shrink-0">
                                <button onclick="approveInvitation('${inv._id}', '${inv.email}', '${inv.name}')" class="btn-primary py-2 px-4 rounded-xl text-xs font-mono font-bold w-full">
                                    <i class="fas fa-check mr-1"></i> Approve & Issue Credentials
                                </button>
                                <button onclick="rejectInvitation('${inv._id}')" class="bg-red-500/10 text-red-500 hover:bg-red-500/20 py-1.5 px-3 rounded-xl text-xs font-mono font-bold w-full">
                                    <i class="fas fa-times mr-1"></i> Reject
                                </button>
                                <button onclick="archiveInvitation('${inv._id}')" class="bg-slate-500/10 text-slate-400 hover:bg-slate-500/20 py-1.5 px-3 rounded-xl text-xs font-mono font-bold w-full">
                                    <i class="fas fa-archive mr-1"></i> Archive
                                </button>
                            </div>
                        ` : ''}
                    `;
                    container.appendChild(card);
                });
            } catch (err) { console.error(err); }
        }

        async function approveInvitation(invitationId, email, name) {
            const suggestedUsername = name.toLowerCase().replace(/[^a-z0-9]/g, '_') || 'reader';
            const assignedUsername = prompt(`Assign username for ${name}:`, suggestedUsername);
            if (!assignedUsername) return;

            const tempPassword = prompt(`Assign temporary password for ${name} (or leave default):`, 'Chronicle' + Math.floor(100000 + Math.random() * 900000));
            if (!tempPassword) return;

            try {
                const res = await fetch(`/api/admin/invitations/${invitationId}/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ assignedUsername, tempPassword })
                });
                const data = await res.json();
                showToast(data.success || data.error, res.ok ? 'success' : 'error');
                loadInvitationRequests();
                loadUsersDirectory();
            } catch (err) { showToast('Error approving invitation', 'error'); }
        }

        async function rejectInvitation(invitationId) {
            if (!confirm('Reject this invitation request and notify applicant via email?')) return;
            try {
                const res = await fetch(`/api/admin/invitations/${invitationId}/reject`, { method: 'POST' });
                const data = await res.json();
                showToast(data.success || data.error, res.ok ? 'success' : 'error');
                loadInvitationRequests();
            } catch (err) { showToast('Error rejecting invitation', 'error'); }
        }

        async function archiveInvitation(invitationId) {
            try {
                const res = await fetch(`/api/admin/invitations/${invitationId}/archive`, { method: 'POST' });
                const data = await res.json();
                showToast(data.success || data.error, res.ok ? 'success' : 'error');
                loadInvitationRequests();
            } catch (err) { showToast('Error archiving invitation', 'error'); }
        }

        async function loadPendingRequests() {
            try {
                const res = await fetch('/api/admin/requests');
                if (!res.ok) return;
                const requests = await res.json();
                const container = document.getElementById('pendingRequestsContainer');
                container.innerHTML = '';

                if (requests.length === 0) {
                    container.innerHTML = '<p class="text-xs font-mono text-journalMuted italic">No pending admin requests.</p>';
                    return;
                }

                requests.forEach(r => {
                    const card = document.createElement('div');
                    card.className = 'bg-journalSurfaceSoft p-4 rounded-2xl border border-amber-500/30 flex flex-col md:flex-row md:items-center justify-between gap-4';
                    card.innerHTML = `
                        <div>
                            <div class="font-bold text-sm text-journalText">${r.username} <span class="text-journalMuted font-normal text-xs">(${r.email})</span></div>
                            <div class="text-xs text-amber-500 font-mono mt-1">Requested Role: <strong>${r.requestedRole || 'Editor'}</strong></div>
                            <div class="text-xs text-journalMuted italic mt-1">"${r.requestReason || 'No reason provided.'}"</div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="approveRequest('${r._id}', '${r.requestedRole || 'Editor'}')" class="btn-primary py-1.5 px-4 rounded-xl text-xs font-mono font-bold">Approve</button>
                            <button onclick="rejectRequest('${r._id}')" class="bg-red-500/10 text-red-500 hover:bg-red-500/20 py-1.5 px-4 rounded-xl text-xs font-mono font-bold">Reject</button>
                        </div>
                    `;
                    container.appendChild(card);
                });
            } catch (err) { console.error(err); }
        }

        async function approveRequest(requestId, role) {
            try {
                const res = await fetch(`/api/admin/requests/${requestId}/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ assignedRole: role })
                });
                const data = await res.json();
                showToast(data.success || data.error, res.ok ? 'success' : 'error');
                loadPendingRequests();
                loadUsersDirectory();
            } catch (err) { showToast('Error approving request', 'error'); }
        }

        async function rejectRequest(requestId) {
            try {
                const res = await fetch(`/api/admin/requests/${requestId}/reject`, { method: 'POST' });
                const data = await res.json();
                showToast(data.success || data.error, res.ok ? 'success' : 'error');
                loadPendingRequests();
            } catch (err) { showToast('Error rejecting request', 'error'); }
        }

        // TAB 3: Permission Matrix Logic
        async function loadPermissionMatrix() {
            try {
                const res = await fetch('/api/admin/roles');
                if (!res.ok) return;
                const data = await res.json();
                const container = document.getElementById('permissionMatrixContainer');
                
                let html = '<table class="w-full text-left text-xs font-mono border-collapse"><thead><tr class="border-b border-journalBorder text-journalMuted uppercase"><th class="p-3">Permission Key</th>';
                Object.values(data.roles).forEach(r => {
                    html += `<th class="p-3 text-center"><span class="badge-role role-${r}">${r}</span></th>`;
                });
                html += '</tr></thead><tbody>';

                data.allPermissions.forEach(perm => {
                    html += `<tr class="border-b border-journalBorder/40"><td class="p-3 font-bold text-journalText">${perm}</td>`;
                    Object.values(data.roles).forEach(r => {
                        const hasPerm = (data.defaultPermissions[r] || []).includes(perm) || r === 'SuperAdmin';
                        html += `<td class="p-3 text-center">${hasPerm ? '<i class="fas fa-check-circle text-emerald-500"></i>' : '<i class="fas fa-times-circle text-journalMuted/30"></i>'}</td>`;
                    });
                    html += '</tr>';
                });

                html += '</tbody></table>';
                container.innerHTML = html;
            } catch (err) { console.error(err); }
        }

        // TAB 4: Active Sessions Logic
        async function loadActiveSessions() {
            try {
                const res = await fetch('/api/admin/sessions');
                if (!res.ok) return;
                const data = await res.json();
                const container = document.getElementById('sessionsContainer');
                container.innerHTML = '';

                if (!data.sessions || data.sessions.length === 0) {
                    container.innerHTML = '<p class="text-xs font-mono text-journalMuted italic">No active session records registered.</p>';
                    return;
                }

                data.sessions.forEach(s => {
                    const card = document.createElement('div');
                    card.className = 'bg-journalSurfaceSoft p-4 rounded-2xl border border-journalBorder flex flex-col md:flex-row md:items-center justify-between gap-4';
                    card.innerHTML = `
                        <div class="space-y-1">
                            <div class="font-bold text-sm text-journalText"><i class="fas fa-desktop text-indigo-500 mr-2"></i>${s.browser || 'Browser'} on ${s.os || 'OS'}</div>
                            <div class="text-xs text-journalMuted font-mono">IP: ${s.ip || '127.0.0.1'} | Login: ${new Date(s.loginTime).toLocaleString()}</div>
                        </div>
                        <button onclick="terminateSession('${s.sessionId}')" class="bg-red-500/10 text-red-500 hover:bg-red-500/20 py-1.5 px-4 rounded-xl text-xs font-mono font-bold">Terminate Session</button>
                    `;
                    container.appendChild(card);
                });
            } catch (err) { console.error(err); }
        }

        async function terminateSession(sessionId) {
            try {
                const res = await fetch(`/api/admin/sessions/${sessionId}`, { method: 'DELETE' });
                const data = await res.json();
                showToast(data.success || data.error, res.ok ? 'success' : 'error');
                loadActiveSessions();
            } catch (err) { showToast('Error terminating session', 'error'); }
        }

        async function terminateAllOtherSessions() {
            if (!confirm('Confirm terminating all other active browser sessions?')) return;
            try {
                const res = await fetch('/api/admin/sessions', { method: 'DELETE' });
                const data = await res.json();
                showToast(data.success || data.error, res.ok ? 'success' : 'error');
                loadActiveSessions();
            } catch (err) { showToast('Error terminating sessions', 'error'); }
        }

        // TAB 5: Audit Trail Logic
        async function loadAuditLogs() {
            try {
                const search = document.getElementById('auditSearchInput').value;
                const result = document.getElementById('auditResultFilter').value;
                const res = await fetch(`/api/admin/audit-logs?search=${encodeURIComponent(search)}&result=${encodeURIComponent(result)}`);
                if (!res.ok) return;
                const data = await res.json();
                const tbody = document.getElementById('auditTableBody');
                tbody.innerHTML = '';

                if (data.logs.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="p-4 text-center italic text-journalMuted">No audit logs matching search parameters.</td></tr>';
                    return;
                }

                data.logs.forEach(l => {
                    const tr = document.createElement('tr');
                    tr.className = 'border-b border-journalBorder/40 hover:bg-journalSurfaceSoft/50';
                    const resBadge = l.result === 'SUCCESS' ? 'text-emerald-500 bg-emerald-500/10' : 'text-red-500 bg-red-500/10';
                    tr.innerHTML = `
                        <td class="p-3 text-journalMuted text-[10px]">${new Date(l.timestamp).toLocaleString()}</td>
                        <td class="p-3 font-bold text-journalText">${l.admin}</td>
                        <td class="p-3 text-indigo-500 font-bold">${l.action}</td>
                        <td class="p-3 text-journalText">${l.target}</td>
                        <td class="p-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${resBadge}">${l.result}</span></td>
                        <td class="p-3 text-journalMuted text-[10px]">${l.ip || '127.0.0.1'} (${l.browser || ''})</td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (err) { console.error(err); }
        }

        // TAB 6: Analytics Logic
        async function loadAnalytics() {
            try {
                const res = await fetch('/api/admin/analytics');
                if (!res.ok) return;
                const data = await res.json();
                document.getElementById('metricTotalUsers').innerText = data.metrics.totalUsers;
                document.getElementById('metricActiveAdmins').innerText = data.metrics.activeAdmins;
                document.getElementById('metricPendingRequests').innerText = data.metrics.pendingRequests;
                document.getElementById('metricFailedLogins').innerText = data.metrics.failedLogins;
            } catch (err) { console.error(err); }
        }

        // Apply UI Security Restrictions Based on User Permissions
        function applyPermissionRestrictions() {
            const perms = window.currentUser.permissions || [];
            const isSuper = window.currentUser.role === 'SuperAdmin';

            // Disable forms if missing edit permission
            if (!isSuper && !perms.includes('skills.edit') && !perms.includes('projects.edit')) {
                document.querySelectorAll('.edit-control').forEach(el => el.classList.add('hidden'));
            }
        }

        // Initialize Page
        document.addEventListener('DOMContentLoaded', () => {
            loadEditorialData('skills', 'skillsContainer', skillTemplate);
            loadEditorialData('projects', 'projectsContainer', projectTemplate);
            loadEditorialData('study', 'studyContainer', studyTemplate);
            loadEditorialData('deadlines', 'deadlineContainer', deadlineTemplate);

            fetch('/api/admin/activity').then(r => r.json()).then(data => {
                const el = document.getElementById('activityText');
                if (el) el.value = data.text || '';
            });

            saveEditorialData('learningForm', 'skills', 'Learning Skills saved successfully!');
            saveEditorialData('workingForm', 'projects', 'Working Projects saved successfully!');
            saveEditorialData('studyForm', 'study', 'Study Focus saved successfully!');
            saveEditorialData('deadlineForm', 'deadlines', 'Deadlines saved successfully!');
            saveEditorialData('activityForm', 'activity', 'Current Activity updated successfully!');

            applyPermissionRestrictions();
        });
    </script>
</body>
</html>
